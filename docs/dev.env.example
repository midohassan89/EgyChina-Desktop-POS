# Copy to a local untracked file (e.g. %USERPROFILE%\EgyChinaPos-dev.env).
# Do NOT commit real values. Leave blank for offline demo (recommended).

# Site origin with trailing slash. Empty = no network.
EGYCHINA_POS_API=

# Enrolled device bearer from POST /api/pos/device/enroll (shown once).
# On Windows the app also stores it under DPAPI as device.cred.
# Never commit. A staff cookie alone does NOT enable sync (phase 3).
EGYCHINA_POS_DEVICE_TOKEN=

# Legacy — ignored for transmission. Do not rely on staff cookies for tills.
# EGYCHINA_POS_COOKIE=

# Verified against local egychina-erp: major (EGP pounds with 2 decimals).
EGYCHINA_POS_MONEY_SCALE=

# Verified cash string in egychina-erp: cash
EGYCHINA_POS_PAYMENT_METHOD=

# Optional. Set to 1 only on a non-production probe after device auth is set.
# Applies live shelf prices/barcodes and flips catalog.source=erp (phase 5).
EGYCHINA_POS_CATALOG_PULL=

# Local bootstrap PINs (phase 6) until ERP staff sync:
# cashier 246810 · supervisor 135790 — change in store ops; not production secrets.
