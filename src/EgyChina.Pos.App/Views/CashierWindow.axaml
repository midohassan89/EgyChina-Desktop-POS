<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EgyChina.Pos.App.ViewModels"
        xmlns:core="using:EgyChina.Pos.Core"
        x:Class="EgyChina.Pos.App.Views.CashierWindow"
        x:DataType="vm:PosSession"
        x:Name="CashierRoot"
        Title="ايجي شاينا — نقطة البيع"
        FlowDirection="RightToLeft"
        WindowStartupLocation="Manual"
        Background="#E2E8F0"
        MinWidth="960"
        MinHeight="680">

  <Grid>
  <Grid RowDefinitions="Auto,*">
    <!-- Compact ops header (web POS toolbar structure) -->
    <Border Grid.Row="0" Background="#0F172A" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="ايجي شاينا ماركت" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
            <Border Background="#059669" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
              <TextBlock Text="POS" FontSize="12" FontWeight="Bold" Foreground="White" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding SessionCaption}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SyncMessage}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OutboxCaption}" FontSize="12" Foreground="#64748B" />
          <TextBlock Text="{Binding SyncErrorCaption}" IsVisible="{Binding HasSyncError}"
                     FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <StackPanel Spacing="0" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ClockText}" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC"
                       FlowDirection="LeftToRight" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding OnlineText}" FontSize="12" Foreground="#34D399" HorizontalAlignment="Left" />
          </StackPanel>
          <Button Content="شاشة العميل"
                  Classes="pos-ghost"
                  Command="{Binding ShowCustomerDisplayCommand}"
                  MinWidth="110" />
          <Button Content="قفل"
                  Classes="pos-ghost"
                  Command="{Binding LockSessionCommand}"
                  IsEnabled="{Binding CanLock}"
                  MinWidth="72" />
          <Button Content="إعادة طباعة"
                  Classes="pos-ghost"
                  Command="{Binding ReprintLastCommand}"
                  IsEnabled="{Binding CanReprint}"
                  MinWidth="100" />
          <Button Content="إغلاق وردية"
                  Classes="pos-ghost"
                  Command="{Binding BeginCloseShiftCommand}"
                  IsEnabled="{Binding CanOpenCloseShiftPanel}"
                  MinWidth="110" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main stage: cart (first in RTL = right) | catalog -->
    <Grid Grid.Row="1" Margin="10" ColumnDefinitions="Auto,10,*">
      <!-- Cart column -->
      <Border Grid.Column="0"
              Width="380"
              Background="#F8FAFC"
              BorderBrush="#CBD5E1"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12">
        <Border.Styles>
          <Style Selector="Border.cart-line">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,8" />
          </Style>
          <Style Selector="Border.cart-line.highlighted">
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
        </Border.Styles>
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="السلة" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LineCountText}" VerticalAlignment="Center" Foreground="#64748B" />
          </Grid>

          <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Spacing="8">
              <Border Background="#ECFDF5" CornerRadius="10" Padding="12,10"
                      IsVisible="{Binding !IsTendering}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding AmountLabel}" Foreground="#047857" FontSize="14" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="28" FontWeight="Bold" Foreground="#047857" />
                </Grid>
              </Border>

              <StackPanel Spacing="8" IsVisible="{Binding IsTendering}">
                <TextBlock Text="المبلغ المستلم" Foreground="#64748B" FontSize="13" />
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBox x:Name="TenderBox"
                           Grid.Column="0"
                           Text="{Binding TenderText, UpdateSourceTrigger=PropertyChanged}"
                           PlaceholderText="0.00"
                           FontSize="22"
                           MinHeight="48"
                           FlowDirection="LeftToRight"
                           KeyDown="OnTenderKeyDown" />
                  <Button Grid.Column="2"
                          Content="بالضبط"
                          Command="{Binding SetExactTenderCommand}" />
                </Grid>
                <TextBlock Text="{Binding TenderHint}" Foreground="#0F172A" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,8,*">
                  <Button Grid.Column="0"
                          Content="تأكيد النقد"
                          Classes="pos-primary"
                          Command="{Binding ConfirmCashCommand}"
                          IsEnabled="{Binding CanConfirmCash}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" />
                  <Button Grid.Column="2"
                          Content="إلغاء"
                          Command="{Binding CancelTenderCommand}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" />
                </Grid>
              </StackPanel>

              <Button Content="إتمام الدفع"
                      Classes="pos-primary"
                      Command="{Binding BeginCashPaymentCommand}"
                      IsEnabled="{Binding CanBeginPayment}"
                      IsVisible="{Binding !IsTendering}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="56"
                      FontSize="20" />

              <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding !IsTendering}">
                <Button Content="تعليق"
                        Command="{Binding HoldCurrentCartCommand}"
                        IsEnabled="{Binding CanHoldCart}"
                        Background="#F59E0B"
                        Foreground="#1C1917"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Content="{Binding HeldCartsButtonText}"
                        Command="{Binding OpenHeldCartsCommand}"
                        IsEnabled="{Binding CanOpenHeldCarts}"
                        Background="#FEF3C7"
                        Foreground="#92400E"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <Button Content="تفريغ السلة"
                      Command="{Binding ClearCartCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />

              <TextBlock Text="{Binding SettlementText}"
                         IsVisible="{Binding ShowSettlement}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="#047857"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock DockPanel.Dock="Top"
                     Text="السلة فارغة — امسح باركود أو اختر صنفاً"
                     IsVisible="{Binding IsCartEmpty}"
                     Margin="0,28,0,0"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     Foreground="#94A3B8"
                     TextWrapping="Wrap" />

          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CartLine">
                  <Border Classes="cart-line" Classes.highlighted="{Binding IsHighlighted}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding NameAr}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#0F172A" />
                      <TextBlock Grid.Column="1" Text="{Binding LineTotalText}" FontWeight="Bold" Foreground="#059669" />
                      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" FlowDirection="LeftToRight">
                          <Button Content="−" Command="{Binding DecrementCommand}" MinWidth="44" Padding="0" FontSize="20" />
                          <Border MinWidth="48" Background="#F1F5F9" CornerRadius="8" Padding="8,6">
                            <TextBlock Text="{Binding QtyText}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FlowDirection="LeftToRight" />
                          </Border>
                          <Button Content="+" Command="{Binding IncrementCommand}" MinWidth="44" Padding="0" FontSize="20" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="حذف"
                                Command="{Binding RemoveCommand}"
                                Background="#FEE2E2"
                                Foreground="#B91C1C"
                                MinWidth="64"
                                Padding="10,6" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Catalog column -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top"
                Background="#FDECEC"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                Margin="0,0,0,8"
                IsVisible="{Binding HasCashierAlert}">
          <TextBlock Text="{Binding CashierAlert}" Foreground="#B91C1C" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto" Margin="0,0,0,8">
          <TextBox x:Name="BarcodeBox"
                   Grid.Column="0"
                   Text="{Binding Barcode}"
                   PlaceholderText="امسح الباركود ثم Enter"
                   FontSize="20"
                   MinHeight="50"
                   KeyDown="OnBarcodeKeyDown" />
          <Button Grid.Column="2"
                  Content="إدخال"
                  Classes="pos-primary"
                  MinWidth="100"
                  Click="OnBarcodeSubmit" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ScanHint}" Margin="0,0,0,8" Foreground="#334155" TextWrapping="Wrap" />

        <TextBox x:Name="SearchBox"
                 DockPanel.Dock="Top"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="بحث بالاسم أو الباركود"
                 MinHeight="44"
                 Margin="0,0,0,8" />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,*,8,Auto" Margin="0,0,0,8">
          <Button Content="الكل"
                  Command="{Binding ShowAllCatalogCommand}"
                  Background="#059669"
                  Foreground="White"
                  Opacity="{Binding CatalogAllEmphasis}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
          <Button Grid.Column="2"
                  Content="المفضلة ★"
                  Command="{Binding ShowFavoritesCatalogCommand}"
                  Background="#059669"
                  Foreground="White"
                  Opacity="{Binding CatalogFavoritesEmphasis}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
          <Button Grid.Column="4"
                  Content="فحص سعر F4"
                  Command="{Binding OpenPriceCheckCommand}"
                  Background="#0284C7"
                  Foreground="White"
                  MinWidth="130" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2">
          <TextBlock Text="{Binding ShortcutHint}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PrinterCaption}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CatalogCaption}" FontSize="12" Foreground="#64748B" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="لا توجد أصناف مطابقة"
                   IsVisible="{Binding HasNoSearchResults}"
                   Margin="0,8,0,0"
                   Foreground="#64748B" />
        <TextBlock DockPanel.Dock="Top"
                   Text="لا مفضلات بعد — اضغط ★ على البطاقة"
                   IsVisible="{Binding HasNoFavorites}"
                   Margin="0,4,0,8"
                   Foreground="#64748B" />

        <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#CBD5E1" BorderThickness="1">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleProducts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:CatalogProduct">
                  <Border Width="220"
                          Margin="0,0,8,8"
                          Padding="12,10"
                          Background="White"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          CornerRadius="12"
                          Cursor="Hand"
                          Tapped="OnProductTapped">
                    <DockPanel>
                      <Button DockPanel.Dock="Top"
                              Content="{Binding FavoriteGlyph}"
                              HorizontalAlignment="Left"
                              MinHeight="36"
                              MinWidth="44"
                              Padding="8,4"
                              Background="#FEF3C7"
                              Foreground="#92400E"
                              FontSize="18"
                              Click="OnFavoriteClick"
                              Tag="{Binding}" />
                      <StackPanel Spacing="4" Margin="0,6,0,0">
                        <TextBlock Text="{Binding NameAr}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#0F172A" />
                        <TextBlock Text="{Binding NameZh}" FontSize="13" Foreground="#64748B" FlowDirection="LeftToRight"
                                   IsVisible="{Binding HasNameZh}" />
                        <TextBlock Text="{Binding PriceEgpText}" FontSize="18" FontWeight="Bold" Foreground="#059669" />
                        <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="#94A3B8" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </Grid>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowHeldCarts}" ZIndex="38">
    <Border Background="White" BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F59E0B" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="السلال المعلّقة" FontSize="24" FontWeight="Bold" Foreground="#1C1917" />
              <TextBlock Text="استرجاع يعلّق السلة الحالية تلقائياً إن لم تكن فارغة" FontSize="13" Foreground="#44403C" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="إغلاق"
                    Command="{Binding CloseHeldCartsCommand}"
                    Background="#D97706"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top"
                   Margin="20,12,20,0"
                   Text="{Binding HeldCartError}"
                   IsVisible="{Binding HasHeldCartError}"
                   Foreground="#B91C1C"
                   TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top"
                   Margin="20,24"
                   Text="لا توجد سلال معلّقة"
                   IsVisible="{Binding !HasHeldCarts}"
                   HorizontalAlignment="Center"
                   Foreground="#78716C" />
        <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding HeldCarts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:HeldCartSummary">
                <Border Margin="0,0,0,10"
                        Padding="14"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="12">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Caption}" FontSize="16" FontWeight="SemiBold" Foreground="#1C1917" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{Binding HeldAt}" FontSize="12" Foreground="#78716C" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="استرجاع"
                              Tag="{Binding}"
                              Click="OnResumeHeldClick"
                              Background="#059669"
                              Foreground="White"
                              MinWidth="88" />
                      <Button Content="حذف"
                              Tag="{Binding}"
                              Click="OnDiscardHeldClick"
                              Background="#FEE2E2"
                              Foreground="#B91C1C"
                              MinWidth="72" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC7F1D1D" IsVisible="{Binding ShowNotFound}" ZIndex="40">
    <Border Background="White" BorderBrush="#EF4444" BorderThickness="4" CornerRadius="16"
            Padding="0" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#DC2626" Padding="20,16">
          <StackPanel Spacing="4">
            <TextBlock Text="المنتج غير متوفر" FontSize="24" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Product not found — أكّد قبل المتابعة" FontSize="14" Foreground="#FECACA" />
          </StackPanel>
        </Border>
        <StackPanel Margin="24" Spacing="14">
          <TextBlock Text="{Binding NotFoundBarcode, StringFormat=الباركود: {0}}"
                     FontSize="18"
                     FontWeight="Bold"
                     Foreground="#0F172A"
                     FlowDirection="LeftToRight"
                     TextWrapping="Wrap" />
          <TextBlock Text="يجب تأكيد الخطأ قبل مسح الصنف التالي." Foreground="#64748B" TextWrapping="Wrap" />
          <Button x:Name="NotFoundOkButton"
                  Content="OK · موافق"
                  Command="{Binding DismissNotFoundCommand}"
                  Background="#DC2626"
                  Foreground="White"
                  FontSize="20"
                  FontWeight="Bold"
                  MinHeight="56"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowPriceCheck}" ZIndex="39">
    <Border Background="White" BorderBrush="#0284C7" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0284C7" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="فحص السعر" FontSize="24" FontWeight="Bold" Foreground="White" />
              <TextBlock Text="استعلام فقط — لا يُضاف للسلة" FontSize="13" Foreground="#E0F2FE" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="إغلاق"
                    Command="{Binding ClosePriceCheckCommand}"
                    Background="#0369A1"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
        </Border>
        <StackPanel Margin="24" Spacing="12">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox x:Name="PriceCheckBox"
                     Grid.Column="0"
                     Text="{Binding PriceCheckQuery}"
                     PlaceholderText="امسح أو اكتب الباركود"
                     FontSize="20"
                     MinHeight="50"
                     FlowDirection="LeftToRight"
                     KeyDown="OnPriceCheckKeyDown" />
            <Button Grid.Column="2"
                    Content="بحث"
                    Command="{Binding SubmitPriceCheckCommand}"
                    Background="#0284C7"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
          <Border IsVisible="{Binding HasPriceCheckResult}"
                  Background="#F0F9FF"
                  BorderBrush="#BAE6FD"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding PriceCheckResult.NameAr}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PriceCheckResult.NameZh}" FontSize="14" Foreground="#64748B"
                         IsVisible="{Binding PriceCheckResult.HasNameZh}" FlowDirection="LeftToRight" />
              <TextBlock Text="{Binding PriceCheckResult.PriceEgpText}" FontSize="28" FontWeight="Bold" Foreground="#0284C7" />
              <TextBlock Text="{Binding PriceCheckResult.Barcode}" FontSize="13" Foreground="#64748B" FlowDirection="LeftToRight" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding PriceCheckError}"
                     IsVisible="{Binding HasPriceCheckError}"
                     Foreground="#B91C1C"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding NeedsLogin}" ZIndex="20">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="دخول الكاشير" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="{Binding SessionCaption}" TextWrapping="Wrap" Foreground="#64748B" />
        <TextBox x:Name="PinBox"
                 Text="{Binding PinText}"
                 PlaceholderText="الرقم السري"
                 PasswordChar="•"
                 FontSize="28"
                 MinHeight="52"
                 FlowDirection="LeftToRight"
                 KeyDown="OnPinKeyDown" />
        <TextBlock Text="{Binding AuthError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="دخول"
                Classes="pos-primary"
                Command="{Binding SubmitPinCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding NeedsOpenShift}" ZIndex="21">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="فتح وردية" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="{Binding CashierName}" Foreground="#64748B" />
        <TextBlock Text="نقدية الافتتاح (ج.م)" Foreground="#64748B" />
        <TextBox x:Name="OpeningFloatBox"
                 Text="{Binding OpeningFloatText}"
                 FontSize="24"
                 MinHeight="52"
                 FlowDirection="LeftToRight"
                 KeyDown="OnOpeningFloatKeyDown" />
        <TextBlock Text="{Binding ShiftError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="فتح الوردية"
                Classes="pos-primary"
                Command="{Binding OpenShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
        <Button Content="قفل الجهاز"
                Command="{Binding LockSessionCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowCloseShift}" ZIndex="22">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="إغلاق الوردية" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="نقدية الإغلاق (ج.م)" Foreground="#64748B" />
        <TextBox x:Name="ClosingCashBox"
                 Text="{Binding ClosingCashText}"
                 FontSize="24"
                 MinHeight="52"
                 FlowDirection="LeftToRight"
                 KeyDown="OnClosingCashKeyDown" />
        <TextBlock Text="{Binding ShiftError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="تأكيد الإغلاق"
                Classes="pos-primary"
                Command="{Binding ConfirmCloseShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
        <Button Content="إلغاء"
                Command="{Binding CancelCloseShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
