<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EgyChina.Pos.App.ViewModels"
        xmlns:core="using:EgyChina.Pos.Core"
        xmlns:data="using:EgyChina.Pos.Data"
        xmlns:controls="using:EgyChina.Pos.App.Controls"
        x:Class="EgyChina.Pos.App.Views.CashierWindow"
        x:DataType="vm:PosSession"
        x:Name="CashierRoot"
        Title="ايجي شاينا — نقطة البيع"
        FlowDirection="RightToLeft"
        WindowStartupLocation="Manual"
        Background="#EEF2F7"
        MinWidth="960"
        MinHeight="680">

  <Grid>
    <!-- Main stage: cart+ops (RTL right) | catalog+OSK — no full-width header -->
    <Grid Margin="10" ColumnDefinitions="Auto,12,*">
      <!-- Cart column: compact ops bar sits only above the order panel -->
      <DockPanel Grid.Column="0" Width="400">
        <!-- Ops: return / info / more — then net+server + last 3 invoices -->
        <Border DockPanel.Dock="Top"
                Background="#0B1220"
                CornerRadius="14"
                Padding="8,8"
                Margin="0,0,0,8"
                IsVisible="{Binding !IsTendering}"
                DoubleTapped="OnHeaderDoubleTapped"
                ToolTip.Tip="ضغطتان هنا للتبديل بين ملء الشاشة والنافذة">
          <Border.Styles>
            <Style Selector="Border.sync-dot">
              <Setter Property="Width" Value="10" />
              <Setter Property="Height" Value="10" />
              <Setter Property="CornerRadius" Value="99" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="Background" Value="#FBBF24" />
            </Style>
            <Style Selector="Border.sync-dot.synced">
              <Setter Property="Background" Value="#22C55E" />
            </Style>
            <Style Selector="Border.sync-dot.pending">
              <Setter Property="Background" Value="#FBBF24" />
            </Style>
            <Style Selector="Border.sync-dot.failed">
              <Setter Property="Background" Value="#EF4444" />
            </Style>
            <Style Selector="Border.link-pill">
              <Setter Property="CornerRadius" Value="10" />
              <Setter Property="Padding" Value="8,5" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style Selector="Border.link-pill.on">
              <Setter Property="Background" Value="#14532D" />
              <Setter Property="BorderBrush" Value="#22C55E" />
              <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="Border.link-pill.off">
              <Setter Property="Background" Value="#334155" />
              <Setter Property="BorderBrush" Value="#64748B" />
              <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="Border.link-pill.on Border.status-lamp">
              <Setter Property="Background" Value="#22C55E" />
            </Style>
            <Style Selector="Border.link-pill.off Border.status-lamp">
              <Setter Property="Background" Value="#94A3B8" />
            </Style>
          </Border.Styles>
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <Button Content="{Binding ReturnModeButtonText}"
                      Classes="pos-chip-return"
                      Command="{Binding ToggleReturnModeCommand}"
                      IsEnabled="{Binding CanToggleReturnMode}"
                      MinHeight="40"
                      Padding="12,6"
                      HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="معلومات"
                        Classes="pos-ghost"
                        Command="{Binding ToggleStatusInfoCommand}"
                        MinHeight="40"
                        Padding="12,6" />
                <Button Content="المزيد ▾"
                        Classes="pos-chip-info"
                        Command="{Binding ToggleMoreActionsCommand}"
                        MinHeight="40"
                        Padding="12,6" />
              </StackPanel>
            </Grid>

            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
              <Border Background="#422006"
                      BorderBrush="#FBBF24"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="8,5"
                      VerticalAlignment="Center"
                      ToolTip.Tip="إصدار البرنامج — افتح معلومات للتحديث اليدوي">
                <TextBlock Text="{Binding AppVersionText}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#FDE68A"
                           VerticalAlignment="Center"
                           FlowDirection="LeftToRight" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Classes="link-pill"
                        Classes.on="{Binding HasInternetLink}"
                        Classes.off="{Binding !HasInternetLink}"
                        ToolTip.Tip="{Binding InternetToolTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="status-lamp" Width="10" Height="10" CornerRadius="99" VerticalAlignment="Center" />
                    <TextBlock Text="شبكة"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Classes="link-pill"
                        Classes.on="{Binding IsServerLinkUp}"
                        Classes.off="{Binding !IsServerLinkUp}"
                        ToolTip.Tip="{Binding ServerToolTip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="status-lamp" Width="10" Height="10" CornerRadius="99" VerticalAlignment="Center" />
                    <TextBlock Text="سيرفر"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding RecentSales}" IsVisible="{Binding HasRecentSales}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:RecentSaleSummary">
                    <Button Tag="{Binding}"
                            Click="OnRecentSaleClick"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            CornerRadius="10"
                            Padding="8,6"
                            MinHeight="36"
                            ToolTip.Tip="{Binding SyncToolTip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="sync-dot"
                                Classes.synced="{Binding IsSynced}"
                                Classes.pending="{Binding IsPending}"
                                Classes.failed="{Binding IsFailed}" />
                        <TextBlock Text="{Binding AmountText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </WrapPanel>

            <TextBlock Text="{Binding CashierName}"
                       FontSize="12"
                       Foreground="#94A3B8"
                       IsVisible="{Binding !NeedsLogin}" />
          </StackPanel>
        </Border>

      <Border Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="18"
              Padding="14"
              BoxShadow="0 8 28 0 #14000000">
        <Border.Styles>
          <Style Selector="Border.cart-line">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
          </Style>
          <Style Selector="Border.cart-line.highlighted">
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
        </Border.Styles>
        <DockPanel>
          <!-- Sticky confirm/cancel while paying — never clipped under the fold -->
          <Grid DockPanel.Dock="Bottom"
                ColumnDefinitions="*,8,*"
                Margin="0,8,0,0"
                IsVisible="{Binding IsTendering}">
            <Button Grid.Column="0"
                    Content="تأكيد الدفع"
                    Classes="pos-primary"
                    Command="{Binding ConfirmCashCommand}"
                    IsEnabled="{Binding CanConfirmCash}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="56"
                    FontSize="18" />
            <Button Grid.Column="2"
                    Content="إلغاء"
                    Classes="pos-tender"
                    Command="{Binding CancelTenderCommand}"
                    Background="#64748B"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="56" />
          </Grid>

          <!-- Compact tender caption replaces the tall cart header -->
          <Border DockPanel.Dock="Top"
                  Background="#0B1220"
                  CornerRadius="12"
                  Padding="12,10"
                  Margin="0,0,0,8"
                  IsVisible="{Binding IsTendering}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="الدفع" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock Text="{Binding LineCountText}" FontSize="12" Foreground="#94A3B8" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding TotalText}"
                         FontSize="22"
                         FontWeight="Bold"
                         Foreground="#6EE7B7"
                         VerticalAlignment="Center"
                         FlowDirection="LeftToRight" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Top"
                  Background="#FEF3C7"
                  BorderBrush="#F59E0B"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  IsVisible="{Binding ShowReturnModeBanner}">
            <TextBlock Text="{Binding ReturnModeBanner}"
                       Foreground="#92400E"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       FontSize="13" />
          </Border>

          <Border DockPanel.Dock="Top"
                  Background="#EFF6FF"
                  BorderBrush="#3B82F6"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  IsVisible="{Binding HasActiveQueueTicket}">
            <TextBlock Text="{Binding ActiveQueueCaption}"
                       Foreground="#1D4ED8"
                       FontWeight="SemiBold"
                       FontSize="13" />
          </Border>

          <Border DockPanel.Dock="Top"
                  Background="#ECFDF5"
                  BorderBrush="#10B981"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  IsVisible="{Binding ShowLoyaltyPanelOutsideTender}">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding LoyaltyCaption}"
                           Foreground="#065F46"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           FontSize="13" />
                <TextBlock Text="{Binding LoyaltyDiscountText}"
                           IsVisible="{Binding ShowLoyaltyDiscount}"
                           Foreground="#B45309"
                           FontWeight="SemiBold"
                           FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{Binding RedeemLoyaltyButtonText}"
                      Command="{Binding ToggleRedeemLoyaltyCommand}"
                      IsEnabled="{Binding CanToggleRedeemLoyalty}"
                      Background="#D1FAE5"
                      Foreground="#065F46"
                      MinWidth="110" />
              <Button Grid.Column="3"
                      Content="إزالة"
                      Command="{Binding ClearLoyaltyCommand}"
                      Background="#FEE2E2"
                      Foreground="#B91C1C"
                      MinWidth="72" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" IsVisible="{Binding !IsTendering}">
            <StackPanel Spacing="8">
              <Border Background="#ECFDF5" CornerRadius="14" Padding="14,12"
                      BorderBrush="#A7F3D0" BorderThickness="1">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding AmountLabel}" Foreground="#047857" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="32" FontWeight="Bold" Foreground="#047857" />
                  </Grid>
                  <TextBlock Text="{Binding LoyaltyDiscountText}"
                             IsVisible="{Binding ShowLoyaltyDiscount}"
                             Foreground="#B45309"
                             FontWeight="SemiBold"
                             FontSize="13" />
                </StackPanel>
              </Border>

              <Button Content="الدفع"
                      Classes="pos-primary"
                      Command="{Binding BeginCashPaymentCommand}"
                      IsEnabled="{Binding CanBeginPayment}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="62"
                      FontSize="24"
                      FontWeight="Bold"
                      CornerRadius="14" />

              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <Border Background="#F1F5F9"
                        CornerRadius="10"
                        Padding="10,8"
                        VerticalAlignment="Stretch"
                        MinHeight="40">
                  <TextBlock Text="{Binding LineCountText}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="#475569"
                             VerticalAlignment="Center" />
                </Border>
                <Button Content="تعليق"
                        Command="{Binding HoldCurrentCartCommand}"
                        IsEnabled="{Binding CanHoldCart}"
                        Classes="pos-chip-warn"
                        MinHeight="40"
                        Padding="12,8" />
                <Button Content="استئناف"
                        Command="{Binding OpenHeldCartsCommand}"
                        IsEnabled="{Binding CanOpenHeldCarts}"
                        Background="#FEF3C7"
                        Foreground="#92400E"
                        CornerRadius="10"
                        MinHeight="40"
                        Padding="12,8" />
                <Button Content="تفريغ"
                        Command="{Binding ClearCartCommand}"
                        Background="#FEE2E2"
                        Foreground="#B91C1C"
                        CornerRadius="10"
                        MinHeight="40"
                        Padding="12,8" />
              </WrapPanel>

              <TextBlock Text="{Binding SettlementText}"
                         IsVisible="{Binding ShowSettlement}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="#047857"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Single fill child: DockPanel would leave a white strip if the last sibling
               is a hidden cart ScrollViewer while tender docks Left by default. -->
          <Grid>
            <StackPanel IsVisible="{Binding ShowEmptyCartHint}"
                        Margin="8,48,8,0"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
              <TextBlock Text="السلة فارغة"
                         FontSize="20"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="#94A3B8" />
              <TextBlock Text="امسح باركود أو اختر صنفاً للبدء"
                         FontSize="14"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         Foreground="#CBD5E1"
                         TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer x:Name="CartLinesScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ShowCartLines}">
              <ItemsControl x:Name="CartLinesList" ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CartLine">
                    <Border Classes="cart-line" Classes.highlighted="{Binding IsHighlighted}">
                      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.RowSpan="2"
                                Width="52"
                                Height="52"
                                CornerRadius="12"
                                Background="#F1F5F9"
                                ClipToBounds="True"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                Tag="{Binding}"
                                Tapped="OnCartLineEditTapped">
                          <Grid>
                            <Border Background="#0B1220"
                                    IsVisible="{Binding ProductId, Converter={StaticResource MissingProductImage}}">
                              <Image Source="{DynamicResource BrandLogo}" Stretch="Uniform" Margin="8" Opacity="0.9" />
                            </Border>
                            <Image Source="{Binding ProductId, Converter={StaticResource ProductImage}}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding ProductId, Converter={StaticResource HasProductImage}}" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Spacing="2"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    Tapped="OnCartLineEditTapped">
                          <TextBlock Text="{Binding DisplayNameAr}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis"
                                     MaxLines="2"
                                     MaxHeight="44"
                                     Foreground="#0F172A" />
                          <TextBlock Text="{Binding DiscountCaption}"
                                     IsVisible="{Binding HasDiscount}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="#B45309" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Spacing="2"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    Tapped="OnCartLineEditTapped">
                          <TextBlock Text="{Binding LineTotalText}" FontWeight="Bold" Foreground="#059669" />
                          <TextBlock Text="تعديل"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="#64748B"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight">
                            <Button Content="−" Command="{Binding DecrementCommand}" Classes="pos-qty" />
                            <Border MinWidth="44" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="10" Padding="10,8"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    Tapped="OnCartLineEditTapped">
                              <TextBlock Text="{Binding QtyText}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         FontWeight="Bold"
                                         FontSize="15"
                                         Foreground="#0F172A"
                                         FlowDirection="LeftToRight" />
                            </Border>
                            <Button Content="+" Command="{Binding IncrementCommand}" Classes="pos-qty" />
                          </StackPanel>
                          <Button Grid.Column="2"
                                  Content="حذف"
                                  Command="{Binding RemoveCommand}"
                                  Classes="pos-qty-del" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsTendering}">
              <Border Background="#0B1220" CornerRadius="16" Padding="12,10" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                  <TextBlock Text="اختر طريقة الدفع" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" />
                  <UniformGrid Columns="3" Rows="2">
                    <Button Margin="3" Tag="Cash" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-cash"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            MinHeight="52">
                      <StackPanel Spacing="1">
                        <TextBlock Text="كاش" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="Cash" FontSize="10" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="3" Tag="Visa" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-visa"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            MinHeight="52">
                      <StackPanel Spacing="1">
                        <TextBlock Text="فيزا" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="Visa" FontSize="10" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="3" Tag="Wallet" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-wallet"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            MinHeight="52">
                      <StackPanel Spacing="1">
                        <TextBlock Text="محفظة" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="Wallet" FontSize="10" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="3" Tag="InstaPay" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-instapay"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            MinHeight="52">
                      <StackPanel Spacing="1">
                        <TextBlock Text="انستا باي" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="InstaPay" FontSize="10" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="3" Tag="WeChat" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-wechat"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            MinHeight="52">
                      <StackPanel Spacing="1">
                        <TextBlock Text="وي شات" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="WeChat" FontSize="10" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                  </UniformGrid>

                  <StackPanel Spacing="6" IsVisible="{Binding IsWeChatPayment}">
                    <TextBlock Text="سعر الصرف (ج.م / يوان)" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,8,Auto">
                      <TextBox x:Name="ExchangeRateBox"
                               Text="{Binding ExchangeRateText, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="18"
                               FlowDirection="LeftToRight"
                               MinHeight="44"
                               GotFocus="OnTouchInputGotFocus" />
                      <Button Grid.Column="2"
                              Content="{Binding WeChatRateRefreshButtonText}"
                              Command="{Binding RefreshWeChatRateFromBankCommand}"
                              Classes="pos-tender"
                              MinHeight="44"
                              MinWidth="96"
                              Padding="12,8"
                              Background="#065F46"
                              IsEnabled="{Binding CanRefreshWeChatRate}"
                              ToolTip.Tip="جلب سعر البنك الحالي مع خصم 4% لتقلبات العملة" />
                    </Grid>
                    <TextBlock Text="افتراضي من الإعدادات، أو حدّث من البنك (−4%)، أو عدّل يدوياً"
                               Foreground="#64748B"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WeChatCnyText}" FontSize="18" FontWeight="Bold" Foreground="#86EFAC" />
                  </StackPanel>

                  <!-- Cash: typed amount first, then quick denominations -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsCashPayment}">
                    <TextBlock Text="المبلغ المستلم" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" />
                    <TextBox x:Name="TenderBox"
                             GotFocus="OnTouchInputGotFocus"
                             Text="{Binding TenderText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="0.00"
                             FontSize="22"
                             MinHeight="48"
                             FlowDirection="LeftToRight"
                             KeyDown="OnTenderKeyDown" />
                    <TextBlock Text="فئات نقدية سريعة" Foreground="#94A3B8" FontSize="12"
                               IsVisible="{Binding ShowQuickCashOptions}" />
                    <ItemsControl ItemsSource="{Binding QuickCashOptions}"
                                  IsVisible="{Binding ShowQuickCashOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickCashOption">
                          <Button Margin="2"
                                  Tag="{Binding AmountMinor}"
                                  Click="OnQuickCashClick"
                                  Classes="pos-tender"
                                  Classes.selected="{Binding IsDefault}"
                                  MinHeight="44"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  Background="#334155"
                                  Foreground="White"
                                  Content="{Binding DisplayText}">
                            <Button.Styles>
                              <Style Selector="Button.selected">
                                <Setter Property="Background" Value="#059669" />
                              </Style>
                              <Style Selector="Button.selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#10B981" />
                              </Style>
                            </Button.Styles>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <TextBlock Text="{Binding TenderHint}"
                             Foreground="#FCA5A5"
                             IsVisible="{Binding CustomerChangeIsShortfall}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding TenderHint}"
                             Foreground="#E2E8F0"
                             IsVisible="{Binding !CustomerChangeIsShortfall}"
                             TextWrapping="Wrap" />

                  <!-- Invoice total last — high contrast for the cashier -->
                  <Border Background="#FEF3C7"
                          CornerRadius="14"
                          Padding="12,10"
                          BorderBrush="#F59E0B"
                          BorderThickness="3">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="قيمة الفاتورة"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#92400E"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="#D97706"
                                CornerRadius="8"
                                Padding="10,4">
                          <TextBlock Text="{Binding PaymentMethodLabel}"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding TotalText}"
                                 FontSize="34"
                                 FontWeight="Bold"
                                 Foreground="#7C2D12"
                                 FlowDirection="LeftToRight"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding PaymentMethodLabelEn}"
                                 FontSize="12"
                                 Foreground="#B45309"
                                 FlowDirection="LeftToRight"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding LoyaltyDiscountText}"
                                 IsVisible="{Binding ShowLoyaltyDiscount}"
                                 Foreground="#B45309"
                                 FontWeight="SemiBold"
                                 FontSize="12"
                                 HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
      </DockPanel>

      <!-- Catalog column: search + products (OSK overlays this column only via Canvas measure) -->
      <DockPanel x:Name="CatalogStage" Grid.Column="2">
        <Border DockPanel.Dock="Top"
                Background="#FDECEC"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                Margin="0,0,0,8"
                IsVisible="{Binding HasCashierAlert}">
          <TextBlock Text="{Binding CashierAlert}" Foreground="#B91C1C" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <!-- Search fills width; All / Favorites / Price check stay visible and wrap on short tills -->
        <Border DockPanel.Dock="Top"
                Background="White"
                CornerRadius="16"
                Padding="10,8"
                Margin="0,0,0,8"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                BoxShadow="0 4 16 0 #0F000000">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox x:Name="BarcodeBox"
                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="ابحث بالاسم أو امسح الباركود..."
                     FontSize="18"
                     MinHeight="44"
                     MinWidth="140"
                     BorderThickness="0"
                     Background="#F8FAFC"
                     CornerRadius="12"
                     Padding="12,8"
                     VerticalAlignment="Center"
                     KeyDown="OnBarcodeKeyDown"
                     GotFocus="OnTouchInputGotFocus" />
            <WrapPanel Grid.Column="2"
                       Orientation="Horizontal"
                       ItemSpacing="8"
                       LineSpacing="8"
                       VerticalAlignment="Center"
                       MaxWidth="360">
              <Button Content="الكل"
                      Command="{Binding ShowAllCatalogCommand}"
                      Classes="pos-tender"
                      Background="#059669"
                      CornerRadius="12"
                      Padding="14,8"
                      MinHeight="44"
                      MinWidth="72"
                      Opacity="{Binding CatalogAllEmphasis}"
                      HorizontalContentAlignment="Center" />
              <Button Content="★ المفضلة"
                      Command="{Binding ShowFavoritesCatalogCommand}"
                      Background="#FEF3C7"
                      Foreground="#92400E"
                      CornerRadius="12"
                      Padding="14,8"
                      MinHeight="44"
                      MinWidth="96"
                      Opacity="{Binding CatalogFavoritesEmphasis}"
                      HorizontalContentAlignment="Center" />
              <Button Content="فحص سعر F4"
                      Command="{Binding OpenPriceCheckCommand}"
                      Classes="pos-chip-info"
                      CornerRadius="12"
                      Padding="14,8"
                      MinHeight="44"
                      MinWidth="110"
                      HorizontalContentAlignment="Center" />
            </WrapPanel>
          </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="لا توجد أصناف مطابقة"
                   IsVisible="{Binding HasNoSearchResults}"
                   Margin="0,8,0,0"
                   Foreground="#64748B" />
        <TextBlock DockPanel.Dock="Top"
                   Text="لا مفضلات بعد — اضغط ★ على البطاقة"
                   IsVisible="{Binding HasNoFavorites}"
                   Margin="0,4,0,8"
                   Foreground="#64748B" />

        <!-- Product grid + transient toast (bottom-left over tiles; no permanent ScanHint strip) -->
        <Grid>
          <Border Background="#FFFFFF" CornerRadius="18" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1"
                  BoxShadow="0 6 20 0 #10000000">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <!-- Virtualized grid: all 3000+ products without loading every bitmap at once -->
              <ItemsRepeater ItemsSource="{Binding VisibleProducts}">
                <ItemsRepeater.Layout>
                  <!-- Compact till tiles: ~4–5 columns on typical 1366–1920 cashier screens -->
                  <UniformGridLayout MinItemWidth="132"
                                     MinItemHeight="152"
                                     MinColumnSpacing="8"
                                     MinRowSpacing="8"
                                     ItemsStretch="Fill"
                                     ItemsJustification="Start" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="core:CatalogProduct">
                    <Border MinHeight="144"
                            Padding="0"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Cursor="Hand"
                            BoxShadow="0 2 10 0 #10000000"
                            Tapped="OnProductTapped">
                      <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Height="72"
                                CornerRadius="12,12,0,0"
                                Background="#F1F5F9"
                                ClipToBounds="True">
                          <Grid>
                            <Border Background="#0B1220"
                                    IsVisible="{Binding Converter={StaticResource MissingProductImage}}">
                              <Image Source="{DynamicResource BrandLogo}"
                                     Stretch="Uniform"
                                     Margin="12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Opacity="0.95" />
                            </Border>
                            <Image Source="{Binding Converter={StaticResource ProductImage}}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   IsVisible="{Binding Converter={StaticResource HasProductImage}}" />
                            <Button Content="{Binding FavoriteGlyph}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="4"
                                    MinHeight="28"
                                    MinWidth="28"
                                    Padding="2,0"
                                    Background="#FEF9C3"
                                    Foreground="#A16207"
                                    CornerRadius="999"
                                    FontSize="12"
                                    Click="OnFavoriteClick"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding Id}" />
                          </Grid>
                        </Border>
                        <StackPanel Spacing="2" Margin="8,6,8,8">
                          <TextBlock Text="{Binding DisplayNameAr}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis" MaxLines="2" MaxHeight="34" Foreground="#0F172A" />
                          <TextBlock Text="{Binding NameZh}" FontSize="10" Foreground="#94A3B8" FlowDirection="LeftToRight"
                                     TextTrimming="CharacterEllipsis" MaxLines="1"
                                     IsVisible="{Binding HasNameZh}" />
                          <Border Background="#ECFDF5" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock Text="{Binding PriceEgpText}" FontSize="13" FontWeight="Bold" Foreground="#047857" />
                          </Border>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </ScrollViewer>
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="16,0,16,16"
                  MaxWidth="420"
                  CornerRadius="14"
                  Padding="14,12"
                  Background="#E01E293B"
                  BoxShadow="0 10 28 0 #55000000"
                  IsHitTestVisible="False"
                  IsVisible="{Binding ShowScanToastInfo}"
                  ZIndex="40">
            <TextBlock Text="{Binding ScanHint}"
                       Foreground="#F8FAFC"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Right" />
          </Border>

          <Border HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="16,0,16,16"
                  MaxWidth="420"
                  CornerRadius="14"
                  Padding="14,12"
                  Background="#E0B91C1C"
                  BorderBrush="#FECACA"
                  BorderThickness="1"
                  BoxShadow="0 10 28 0 #55000000"
                  IsHitTestVisible="False"
                  IsVisible="{Binding ShowScanToastWarning}"
                  ZIndex="41">
            <TextBlock Text="{Binding ScanHint}"
                       Foreground="#FEF2F2"
                       FontSize="14"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       TextAlignment="Right" />
          </Border>
        </Grid>
      </DockPanel>
    </Grid>

  <!-- Form + numeric pad side-by-side so short tills never cover Apply -->
  <Border Background="#CC0F172A" IsVisible="{Binding ShowPrintPrompt}" ZIndex="48">
    <Border Background="White"
            BorderBrush="#059669"
            BorderThickness="3"
            CornerRadius="20"
            Padding="0"
            Width="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BoxShadow="0 24 60 0 #66000000">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#059669" Padding="22,18">
          <StackPanel Spacing="4">
            <TextBlock Text="طباعة الإيصال؟" FontSize="24" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="عدد الأصناف قليل — اختر قبل المتابعة"
                       FontSize="13"
                       Foreground="#D1FAE5" />
          </StackPanel>
        </Border>
        <StackPanel Margin="22,20" Spacing="16">
          <TextBlock Text="{Binding PrintPromptCaption}"
                     FontSize="16"
                     Foreground="#0F172A"
                     TextWrapping="Wrap"
                     LineHeight="26" />
          <Grid ColumnDefinitions="*,10,*">
            <Button Content="طباعة"
                    Classes="pos-primary"
                    Command="{Binding ConfirmPrintReceiptCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="56"
                    FontSize="18"
                    FontWeight="Bold" />
            <Button Grid.Column="2"
                    Content="بدون طباعة"
                    Command="{Binding SkipPrintReceiptCommand}"
                    Background="#F1F5F9"
                    Foreground="#334155"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="56"
                    FontSize="17" />
          </Grid>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowEditLine}" ZIndex="42">
    <Grid x:Name="EditLineShell"
          Margin="16"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxHeight="740"
          ColumnDefinitions="Auto,14,Auto">
      <Border Background="White"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="20"
              Padding="0"
              MinWidth="320"
              MaxWidth="440"
              BoxShadow="0 24 60 0 #66000000">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4" Margin="0,0,12,0">
                <TextBlock Text="تعديل الصنف" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="{Binding EditLineName}"
                           FontSize="14"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="2" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="✕"
                      Command="{Binding CloseEditLineCommand}"
                      Classes="pos-ghost"
                      MinWidth="44"
                      MinHeight="44"
                      VerticalAlignment="Top" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="18,14">
            <Grid ColumnDefinitions="*,10,*">
              <Button Content="تطبيق"
                      Classes="pos-primary"
                      Command="{Binding ApplyEditLineCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="52"
                      FontSize="17"
                      FontWeight="Bold" />
              <Button Grid.Column="2"
                      Content="إلغاء"
                      Command="{Binding CloseEditLineCommand}"
                      Background="#F8FAFC"
                      Foreground="#334155"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="52"
                      FontSize="16" />
            </Grid>
          </Border>

          <ScrollViewer Margin="18,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="الكمية" FontSize="14" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox x:Name="EditQtyBox"
                         GotFocus="OnTouchInputGotFocus"
                         Text="{Binding EditQtyText, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding !EditQtyLocked}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         MinHeight="48"
                         FlowDirection="LeftToRight" />
                <TextBlock Text="كمية الميزان ثابتة من ملصق الوزن"
                           IsVisible="{Binding EditQtyLocked}"
                           FontSize="12"
                           Foreground="#B45309"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="سعر الوحدة (ج.م)" FontSize="14" FontWeight="SemiBold" Foreground="#334155" />
                <TextBox x:Name="EditUnitPriceBox"
                         GotFocus="OnTouchInputGotFocus"
                         Text="{Binding EditUnitPriceText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         MinHeight="48"
                         FlowDirection="LeftToRight" />
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="الخصم" FontSize="14" FontWeight="SemiBold" Foreground="#334155" />
                <UniformGrid Columns="3">
                  <Button Margin="0,0,4,0"
                          Content="بدون"
                          Command="{Binding SetEditDiscountNoneCommand}"
                          Classes="pos-tender"
                          Classes.selected="{Binding IsEditDiscountNone}"
                          MinHeight="46"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Background="#F8FAFC"
                          Foreground="#475569"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1">
                    <Button.Styles>
                      <Style Selector="Button.selected">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="Foreground" Value="#065F46" />
                        <Setter Property="BorderBrush" Value="#059669" />
                        <Setter Property="BorderThickness" Value="2" />
                      </Style>
                    </Button.Styles>
                  </Button>
                  <Button Margin="2,0"
                          Content="%"
                          Command="{Binding SetEditDiscountPercentCommand}"
                          Classes="pos-tender"
                          Classes.selected="{Binding IsEditDiscountPercent}"
                          MinHeight="46"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Background="#F8FAFC"
                          Foreground="#475569"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1">
                    <Button.Styles>
                      <Style Selector="Button.selected">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="Foreground" Value="#065F46" />
                        <Setter Property="BorderBrush" Value="#059669" />
                        <Setter Property="BorderThickness" Value="2" />
                      </Style>
                    </Button.Styles>
                  </Button>
                  <Button Margin="4,0,0,0"
                          Content="ج.م"
                          Command="{Binding SetEditDiscountFlatCommand}"
                          Classes="pos-tender"
                          Classes.selected="{Binding IsEditDiscountFlat}"
                          MinHeight="46"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Background="#F8FAFC"
                          Foreground="#475569"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1">
                    <Button.Styles>
                      <Style Selector="Button.selected">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="Foreground" Value="#065F46" />
                        <Setter Property="BorderBrush" Value="#059669" />
                        <Setter Property="BorderThickness" Value="2" />
                      </Style>
                    </Button.Styles>
                  </Button>
                </UniformGrid>
                <TextBox x:Name="EditDiscountBox"
                         GotFocus="OnTouchInputGotFocus"
                         Text="{Binding EditDiscountValueText, UpdateSourceTrigger=PropertyChanged}"
                         IsVisible="{Binding ShowEditDiscountValue}"
                         PlaceholderText="{Binding EditDiscountPlaceholder}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         MinHeight="48"
                         FlowDirection="LeftToRight" />
              </StackPanel>

              <Border Background="#0B1220" CornerRadius="14" Padding="16,14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="إجمالي السطر" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding EditPreviewTotalText}"
                             FontSize="26"
                             FontWeight="Bold"
                             Foreground="White"
                             FlowDirection="LeftToRight" />
                </Grid>
              </Border>

              <TextBlock Text="{Binding EditLineError}"
                         IsVisible="{Binding HasEditLineError}"
                         Foreground="#B91C1C"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2"
              Background="#0B1220"
              BorderBrush="#334155"
              BorderThickness="1"
              CornerRadius="20"
              MinWidth="260"
              MaxWidth="320"
              Padding="4,4,4,8"
              BoxShadow="0 24 60 0 #66000000"
              VerticalAlignment="Stretch">
        <controls:TouchKeyboard x:Name="EditLineNumpad"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
      </Border>
    </Grid>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowHeldCarts}" ZIndex="38">
    <Border Background="White" BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F59E0B" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="السلال المعلّقة" FontSize="24" FontWeight="Bold" Foreground="#1C1917" />
              <TextBlock Text="استرجاع يعلّق السلة الحالية تلقائياً إن لم تكن فارغة" FontSize="13" Foreground="#44403C" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="إغلاق"
                    Command="{Binding CloseHeldCartsCommand}"
                    Background="#D97706"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top"
                   Margin="20,12,20,0"
                   Text="{Binding HeldCartError}"
                   IsVisible="{Binding HasHeldCartError}"
                   Foreground="#B91C1C"
                   TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top"
                   Margin="20,24"
                   Text="لا توجد سلال معلّقة"
                   IsVisible="{Binding !HasHeldCarts}"
                   HorizontalAlignment="Center"
                   Foreground="#78716C" />
        <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding HeldCarts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:HeldCartSummary">
                <Border Margin="0,0,0,10"
                        Padding="14"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="12">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Caption}" FontSize="16" FontWeight="SemiBold" Foreground="#1C1917" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{Binding HeldAt}" FontSize="12" Foreground="#78716C" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="استرجاع"
                              Tag="{Binding}"
                              Click="OnResumeHeldClick"
                              Background="#059669"
                              Foreground="White"
                              MinWidth="88" />
                      <Button Content="حذف"
                              Tag="{Binding}"
                              Click="OnDiscardHeldClick"
                              Background="#FEE2E2"
                              Foreground="#B91C1C"
                              MinWidth="72" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowSupervisorPin}" ZIndex="45">
    <Border Background="#F8FAFC" BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="460" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,48,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#B45309" Padding="20,16">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding SupervisorTitle}" FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
            <TextBlock Text="رقم سري للمشرف أو المدير فقط" FontSize="13" Foreground="#FDE68A" />
          </StackPanel>
        </Border>
        <StackPanel Margin="24" Spacing="12">
          <TextBlock Text="{Binding SupervisorHint}" Foreground="#64748B" TextWrapping="Wrap" />
          <TextBox x:Name="SupervisorPinBox"
                   GotFocus="OnTouchInputGotFocus"
                   Text="{Binding SupervisorPinText, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="الرقم السري"
                   PasswordChar="•"
                   FontSize="28"
                   MinHeight="52"
                   FlowDirection="LeftToRight"
                   KeyDown="OnSupervisorPinKeyDown" />
          <TextBlock Text="{Binding SupervisorError}"
                     IsVisible="{Binding HasSupervisorError}"
                     Foreground="#B91C1C"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,8,*">
            <Button Grid.Column="0"
                    Content="تأكيد"
                    Classes="pos-primary"
                    Command="{Binding SubmitSupervisorPinCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="48" />
            <Button Grid.Column="2"
                    Content="إلغاء"
                    Command="{Binding CancelSupervisorPinCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="48" />
          </Grid>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#E0111111" IsVisible="{Binding ShowNotFound}" ZIndex="40">
    <Border Background="#FFF7F7" BorderBrush="#B91C1C" BorderThickness="5" CornerRadius="18"
            Padding="0" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="0 20 50 0 #66000000">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#B91C1C" Padding="22,18">
          <StackPanel Spacing="4">
            <TextBlock Text="المنتج غير متوفر" FontSize="26" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Product not found — أكّد قبل المتابعة" FontSize="14" Foreground="#FECACA" />
          </StackPanel>
        </Border>
        <StackPanel Margin="24" Spacing="14">
          <Border Background="#FEE2E2" CornerRadius="12" Padding="14,10">
            <TextBlock Text="{Binding NotFoundBarcode, StringFormat=الباركود: {0}}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#7F1D1D"
                       FlowDirection="LeftToRight"
                       TextWrapping="Wrap" />
          </Border>
          <TextBlock Text="يجب تأكيد الخطأ قبل مسح الصنف التالي." Foreground="#334155" FontSize="15" TextWrapping="Wrap" />
          <Button x:Name="NotFoundOkButton"
                  Content="OK · موافق"
                  Command="{Binding DismissNotFoundCommand}"
                  Background="#B91C1C"
                  Foreground="White"
                  FontSize="22"
                  FontWeight="Bold"
                  MinHeight="60"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  CornerRadius="12" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowPriceCheck}" ZIndex="39">
    <Border Background="White" BorderBrush="#0284C7" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0284C7" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="فحص السعر" FontSize="24" FontWeight="Bold" Foreground="White" />
              <TextBlock Text="استعلام فقط — لا يُضاف للسلة" FontSize="13" Foreground="#E0F2FE" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="إغلاق"
                    Command="{Binding ClosePriceCheckCommand}"
                    Background="#0369A1"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
        </Border>
        <StackPanel Margin="24" Spacing="12">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox x:Name="PriceCheckBox"
                     GotFocus="OnTouchInputGotFocus"
                     Grid.Column="0"
                     Text="{Binding PriceCheckQuery}"
                     PlaceholderText="امسح أو اكتب الباركود"
                     FontSize="20"
                     MinHeight="50"
                     FlowDirection="LeftToRight"
                     KeyDown="OnPriceCheckKeyDown" />
            <Button Grid.Column="2"
                    Content="بحث"
                    Command="{Binding SubmitPriceCheckCommand}"
                    Background="#0284C7"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
          <Border IsVisible="{Binding HasPriceCheckResult}"
                  Background="#F0F9FF"
                  BorderBrush="#BAE6FD"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding PriceCheckResult.NameAr}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PriceCheckResult.NameZh}" FontSize="14" Foreground="#64748B"
                         IsVisible="{Binding PriceCheckResult.HasNameZh}" FlowDirection="LeftToRight" />
              <TextBlock Text="{Binding PriceCheckResult.PriceEgpText}" FontSize="28" FontWeight="Bold" Foreground="#0284C7" />
              <TextBlock Text="{Binding PriceCheckResult.Barcode}" FontSize="13" Foreground="#64748B" FlowDirection="LeftToRight" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding PriceCheckError}"
                     IsVisible="{Binding HasPriceCheckError}"
                     Foreground="#B91C1C"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding NeedsLogin}" ZIndex="20">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="دخول الكاشير" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="{Binding SessionCaption}" TextWrapping="Wrap" Foreground="#64748B" />
        <TextBox x:Name="PinBox"
                 GotFocus="OnTouchInputGotFocus"
                 Text="{Binding PinText}"
                 PlaceholderText="PIN الموظف"
                 PasswordChar="•"
                 FontSize="28"
                 MinHeight="52"
                 FlowDirection="LeftToRight"
                 KeyDown="OnPinKeyDown" />
        <TextBlock Text="{Binding AuthError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="دخول"
                Classes="pos-primary"
                Command="{Binding SubmitPinCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding NeedsOpenShift}" ZIndex="21">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="فتح وردية" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="{Binding CashierName}" Foreground="#64748B" />
        <TextBlock Text="نقدية الافتتاح (ج.م)" Foreground="#64748B" />
        <TextBox x:Name="OpeningFloatBox"
                 GotFocus="OnTouchInputGotFocus"
                 Text="{Binding OpeningFloatText}"
                 FontSize="24"
                 MinHeight="52"
                 FlowDirection="LeftToRight"
                 KeyDown="OnOpeningFloatKeyDown" />
        <TextBlock Text="{Binding ShiftError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="فتح الوردية"
                Classes="pos-primary"
                Command="{Binding OpenShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
        <Button Content="تسجيل خروج"
                Command="{Binding LockSessionCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowCloseShift}" ZIndex="22">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="24" Width="480" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <TextBlock Text="إغلاق الوردية · تقرير Z" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
          <Border IsVisible="{Binding HasZReport}"
                  Background="#F1F5F9"
                  CornerRadius="10"
                  Padding="12"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding CurrentZReport.CashierName}" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.TicketCountText, StringFormat=عدد التذاكر: {0}}" Foreground="#475569" />
              <TextBlock Text="{Binding CurrentZReport.ReturnTicketCountText, StringFormat=استرجاع: {0}}" Foreground="#475569" />
              <TextBlock Text="{Binding CurrentZReport.CashSalesText, StringFormat=نقد: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.VisaSalesText, StringFormat=فيزا: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.WalletSalesText, StringFormat=محفظة: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.InstaPaySalesText, StringFormat=انستا باي: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.WeChatSalesText, StringFormat=وي شات: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.CashRefundsText, StringFormat=مردود نقدي: {0}}" Foreground="#B45309" />
              <TextBlock Text="{Binding CurrentZReport.TotalSalesText, StringFormat=إجمالي المبيعات: {0}}" FontWeight="Bold" Foreground="#047857" />
              <TextBlock Text="{Binding CurrentZReport.ExpectedCashText, StringFormat=النقد المتوقع في الدرج: {0}}" FontWeight="Bold" Foreground="#1D4ED8" />
            </StackPanel>
          </Border>
          <TextBlock Text="نقدية الإغلاق الفعلية (ج.م)" Foreground="#64748B" />
          <TextBox x:Name="ClosingCashBox"
                   GotFocus="OnTouchInputGotFocus"
                   Text="{Binding ClosingCashText, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="24"
                   MinHeight="52"
                   FlowDirection="LeftToRight"
                   KeyDown="OnClosingCashKeyDown" />
          <TextBlock Text="{Binding ZReportVarianceText}"
                     IsVisible="{Binding HasZReport}"
                     FontWeight="SemiBold"
                     Foreground="#0F172A"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ShiftError}" Foreground="#B91C1C" TextWrapping="Wrap" />
          <Button Content="تأكيد الإغلاق"
                  Classes="pos-primary"
                  Command="{Binding ConfirmCloseShiftCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  MinHeight="48" />
          <Button Content="إلغاء"
                  Command="{Binding CancelCloseShiftCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowOnlineOrders}" ZIndex="38">
    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0"
            Width="420" HorizontalAlignment="Left" VerticalAlignment="Stretch">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="16,12">
          <Grid ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Text="طلبات الأونلاين" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="تحديث"
                    Command="{Binding RefreshOnlineOrdersCommand}"
                    Background="#1E293B"
                    Foreground="White"
                    MinWidth="72" />
            <Button Grid.Column="3"
                    Content="إغلاق"
                    Command="{Binding CloseOnlineOrdersCommand}"
                    Background="#334155"
                    Foreground="White"
                    MinWidth="72" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding OnlineOrdersError}"
                   IsVisible="{Binding HasOnlineOrdersError}"
                   Background="#FEF2F2"
                   Foreground="#B91C1C"
                   Padding="12,8"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top"
                   Text="لا توجد طلبات أونلاين"
                   IsVisible="{Binding HasNoOnlineOrders}"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"
                   Foreground="#94A3B8" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding OnlineOrders}" Margin="12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:OnlineOrderSummary">
                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,10">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                      <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="Bold" Foreground="#059669" />
                    </Grid>
                    <TextBlock Text="{Binding StatusLabelAr}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" />
                    <TextBlock Text="{Binding CustomerName}" Foreground="#334155" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Phone}" Foreground="#64748B" FlowDirection="LeftToRight" />
                    <TextBlock Text="{Binding Address}"
                               IsVisible="{Binding HasAddress}"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               FontSize="12" />
                    <TextBlock Text="{Binding ItemsSummary}" Foreground="#475569" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding AssignedDriverName, StringFormat=السائق: {0}}"
                               IsVisible="{Binding HasAssignedDriver}"
                               Foreground="#78716C"
                               FontSize="12" />
                    <TextBlock Text="{Binding Notes}"
                               IsVisible="{Binding HasNotes}"
                               Foreground="#A16207"
                               TextWrapping="Wrap"
                               FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#990B1220" IsVisible="{Binding ShowMoreActions}" ZIndex="45"
          PointerPressed="OnMoreActionsBackdrop">
    <Border Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="16"
            Padding="16" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,64,16,0" BoxShadow="0 16 40 0 #60000000">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="المزيد" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
          <Button Grid.Column="1" Content="إغلاق" Command="{Binding CloseMoreActionsCommand}"
                  Classes="pos-tender" Background="#64748B" MinWidth="72" MinHeight="40" />
        </Grid>
        <Button Content="{Binding OnlineOrdersButtonText}"
                Classes="pos-chip-online"
                Command="{Binding OpenOnlineOrdersCommand}"
                IsEnabled="{Binding CanOpenOnlineOrders}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="فتح الدرج"
                Classes="pos-chip-drawer"
                Command="{Binding OpenCashDrawerCommand}"
                IsEnabled="{Binding CanOpenDrawer}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="شاشة العميل"
                Classes="pos-chip-info"
                Command="{Binding ShowCustomerDisplayCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="{Binding CashierDisplayModeButtonText}"
                Classes="pos-tender"
                Background="#1D4ED8"
                Command="{Binding ToggleCashierKioskCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="تحديث الأصناف الآن"
                Classes="pos-tender"
                Background="#059669"
                Command="{Binding RefreshCatalogCommand}"
                IsEnabled="{Binding CanRefreshCatalog}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                ToolTip.Tip="يسحب الأسعار والمنتجات الجديدة من ERP فوراً" />
        <TextBlock Text="{Binding CatalogRefreshHint}"
                   IsVisible="{Binding HasCatalogRefreshHint}"
                   FontSize="12"
                   Foreground="#A7F3D0"
                   TextWrapping="Wrap" />
        <Button Content="مبيعات بانتظار الرفع"
                Classes="pos-tender"
                Background="#0EA5E9"
                Command="{Binding OpenOutboxPanelCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="تقفيل الكاشير"
                Classes="pos-chip-danger"
                Command="{Binding BeginCloseShiftCommand}"
                IsEnabled="{Binding CanOpenCloseShiftPanel}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="تسجيل خروج"
                Classes="pos-ghost"
                Command="{Binding LockSessionCommand}"
                IsEnabled="{Binding CanLock}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#990B1220" IsVisible="{Binding ShowStatusInfo}" ZIndex="45"
          PointerPressed="OnStatusInfoBackdrop">
    <Border Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="16"
            Padding="16" Width="360" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,64,120,0" BoxShadow="0 16 40 0 #60000000">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="حالة الجهاز" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
          <Button Grid.Column="1" Content="إغلاق" Command="{Binding CloseStatusInfoCommand}"
                  Classes="pos-tender" Background="#64748B" MinWidth="72" MinHeight="40" />
        </Grid>
        <TextBlock Text="{Binding ClockText}" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"
                   FlowDirection="LeftToRight" />
        <Border Background="#1E3A5F"
                BorderBrush="#FBBF24"
                BorderThickness="2"
                CornerRadius="12"
                Padding="12,10">
          <StackPanel Spacing="4">
            <TextBlock Text="إصدار البرنامج"
                       FontSize="12"
                       Foreground="#93C5FD" />
            <TextBlock Text="{Binding AppVersionText}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FDE68A"
                       FlowDirection="LeftToRight" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding UpdateHint}" IsVisible="{Binding HasUpdateHint}"
                   FontSize="13" Foreground="#A7F3D0" TextWrapping="Wrap" />
        <Button Content="{Binding CheckUpdatesButtonText}"
                Classes="pos-tender"
                Background="#7C3AED"
                Command="{Binding CheckForUpdatesCommand}"
                IsEnabled="{Binding CanCheckForUpdates}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="44" />
        <TextBlock Text="{Binding SessionChipText}" FontSize="14" Foreground="#F9A8D4" />
        <TextBlock Text="{Binding OnlineText}" FontSize="14" Foreground="#A7F3D0" />
        <TextBlock Text="{Binding OutboxStatusText}" FontSize="14" Foreground="#E2E8F0" />
        <TextBlock Text="{Binding PrinterCaption}" FontSize="14" Foreground="#CBD5E1" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ScreenModeText}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SyncMessage}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SyncErrorCaption}" IsVisible="{Binding HasSyncError}"
                   FontSize="13" Foreground="#FCA5A5" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CatalogCaption}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CatalogRefreshHint}"
                   IsVisible="{Binding HasCatalogRefreshHint}"
                   FontSize="12"
                   Foreground="#A7F3D0"
                   TextWrapping="Wrap" />
        <Button Content="تحديث الأصناف الآن"
                Classes="pos-tender"
                Background="#059669"
                Command="{Binding RefreshCatalogCommand}"
                IsEnabled="{Binding CanRefreshCatalog}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="مبيعات بانتظار الرفع"
                Classes="pos-tender"
                Background="#0EA5E9"
                Command="{Binding OpenOutboxPanelCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowOutboxPanel}" ZIndex="46">
    <Border Background="White" BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F59E0B" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="مبيعات بانتظار الرفع" FontSize="22" FontWeight="Bold" Foreground="#1C1917" />
              <TextBlock Text="مبيعات تمت على الجهاز ولم تُرفع بعد لسيرفر ERP" FontSize="13" Foreground="#44403C" />
            </StackPanel>
            <Button Grid.Column="1" Content="تحديث" Command="{Binding RefreshOutboxPanelCommand}"
                    Background="#D97706" Foreground="White" MinWidth="80" />
            <Button Grid.Column="3" Content="إعادة محاولة" Command="{Binding RetryOutboxSyncCommand}"
                    Background="#059669" Foreground="White" MinWidth="110" />
            <Button Grid.Column="5" Content="إغلاق" Command="{Binding CloseOutboxPanelCommand}"
                    Background="#92400E" Foreground="White" MinWidth="80" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding OutboxPanelHint}"
                   IsVisible="{Binding HasOutboxPanelHint}"
                   Margin="16,12,16,0" Foreground="#047857" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding SyncErrorCaption}"
                   IsVisible="{Binding HasSyncError}"
                   Margin="16,8,16,0" Foreground="#B91C1C" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Text="لا عناصر معلّقة أو تالفة"
                   IsVisible="{Binding HasNoOutboxRows}"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Foreground="#94A3B8" />
        <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding OutboxRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="data:OutboxHealthRow">
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                        CornerRadius="12" Padding="12" Margin="0,0,0,10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#92400E" />
                    <TextBlock Text="{Binding AttemptCount, StringFormat=محاولات: {0}}" FontSize="12" Foreground="#64748B" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <!-- Canvas Left/Bottom = physical pixels (ignore RTL). Null background + hit-testable so only the pad captures clicks. -->
  <Canvas x:Name="OskLayer"
          ZIndex="120"
          IsHitTestVisible="True"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="{x:Null}">
    <Border x:Name="OnScreenKeyboardHost"
            Background="#0B1220"
            CornerRadius="14,14,0,0"
            IsVisible="False"
            IsHitTestVisible="True"
            BoxShadow="0 -8 24 0 #88000000">
      <controls:TouchKeyboard x:Name="OnScreenKeyboard"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              IsHitTestVisible="True" />
    </Border>
  </Canvas>
  </Grid>
</Window>
