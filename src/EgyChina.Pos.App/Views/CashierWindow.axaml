<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EgyChina.Pos.App.ViewModels"
        xmlns:core="using:EgyChina.Pos.Core"
        x:Class="EgyChina.Pos.App.Views.CashierWindow"
        x:DataType="vm:PosSession"
        x:Name="CashierRoot"
        Title="ايجي شاينا — نقطة البيع"
        FlowDirection="RightToLeft"
        WindowStartupLocation="Manual"
        Background="#F3F0E8"
        MinWidth="880"
        MinHeight="640">

  <Grid>
  <Grid RowDefinitions="Auto,*,Auto" IsEnabled="{Binding CanOperate}">
    <Border Grid.Row="0" Background="#12382F" Padding="18,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="ايجي شاينا ماركت" FontSize="22" FontWeight="Bold" Foreground="#F6F1E4" />
          <TextBlock Text="سوق العبور  ·  نقطة البيع" FontSize="13" Foreground="#D5C7A4" />
          <TextBlock Text="{Binding SessionCaption}" FontSize="13" Foreground="#E3C57A" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Left" MaxWidth="460">
          <TextBlock Text="{Binding ClockText}" FontSize="20" FontWeight="SemiBold" Foreground="#F6F1E4"
                     FlowDirection="LeftToRight" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding OnlineText}" Foreground="#E3C57A" FontSize="13" />
          <TextBlock Text="{Binding SyncMessage}" Foreground="#F6F1E4" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OutboxCaption}" Foreground="#D5C7A4" FontSize="12" />
          <TextBlock Text="{Binding SyncErrorCaption}" IsVisible="{Binding HasSyncError}"
                     Foreground="#E8A0A0" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ScreenModeText}" Foreground="#D5C7A4" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Content="قفل"
                    Command="{Binding LockSessionCommand}"
                    IsEnabled="{Binding CanLock}"
                    MinWidth="88" />
            <Button Content="إغلاق وردية"
                    Command="{Binding BeginCloseShiftCommand}"
                    IsEnabled="{Binding CanOpenCloseShiftPanel}"
                    MinWidth="120" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="12" ColumnDefinitions="1.45*,12,*">
      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto" Margin="0,0,0,8">
          <TextBox x:Name="BarcodeBox"
                   Grid.Column="0"
                   Text="{Binding Barcode}"
                   PlaceholderText="امسح الباركود ثم Enter"
                   FontSize="20"
                   MinHeight="48"
                   KeyDown="OnBarcodeKeyDown" />
          <Button Grid.Column="2"
                  Content="إدخال"
                  MinWidth="96"
                  Click="OnBarcodeSubmit" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ScanHint}" Margin="0,0,0,8" Foreground="#3E4A3A" TextWrapping="Wrap" />
        <TextBox DockPanel.Dock="Top"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="بحث بالاسم أو الباركود"
                 MinHeight="44"
                 Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top"
                   Text="لا توجد أصناف مطابقة"
                   IsVisible="{Binding HasNoSearchResults}"
                   Margin="0,12,0,0"
                   Foreground="#6E675C" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding VisibleProducts}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:CatalogProduct">
                <Border Width="230"
                        Margin="0,0,8,8"
                        Padding="12,10"
                        Background="#FFFcfaf4"
                        BorderBrush="#DDD6C8"
                        BorderThickness="1"
                        CornerRadius="10"
                        Cursor="Hand"
                        Tapped="OnProductTapped">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding NameAr}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1C1A16" />
                    <TextBlock Text="{Binding NameZh}" FontSize="13" Foreground="#6E675C" FlowDirection="LeftToRight"
                               IsVisible="{Binding HasNameZh}" />
                    <TextBlock Text="{Binding PriceEgpText}" FontSize="16" FontWeight="Bold" Foreground="#12382F" />
                    <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="#8A8172" FlowDirection="LeftToRight" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="2" Background="#FFFcfaf4" BorderBrush="#DDD6C8" BorderThickness="1" CornerRadius="12" Padding="12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="السلة" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LineCountText}" VerticalAlignment="Center" Foreground="#6E675C" />
          </Grid>
          <Button DockPanel.Dock="Bottom"
                  Content="تفريغ السلة"
                  Command="{Binding ClearCartCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Margin="0,8,0,0" />
          <TextBlock DockPanel.Dock="Top"
                     Text="السلة فارغة"
                     IsVisible="{Binding IsCartEmpty}"
                     Margin="0,24,0,0"
                     HorizontalAlignment="Center"
                     Foreground="#8A8172" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CartLine">
                  <Border BorderBrush="#E6E0D4" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding NameAr}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding LineTotalText}" FontWeight="SemiBold" />
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" FlowDirection="LeftToRight">
                        <Button Content="-" Command="{Binding DecrementCommand}" MinWidth="44" Padding="0" />
                        <TextBlock Text="{Binding QtyText}" VerticalAlignment="Center" MinWidth="36" HorizontalAlignment="Center" />
                        <Button Content="+" Command="{Binding IncrementCommand}" MinWidth="44" Padding="0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#E7E1D4" Padding="16,10">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,12,Auto" IsVisible="{Binding IsTendering}">
          <StackPanel Spacing="4">
            <TextBlock Text="المبلغ المستلم" Foreground="#6E675C" FontSize="13" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox x:Name="TenderBox"
                       Grid.Column="0"
                       Text="{Binding TenderText, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="0.00"
                       FontSize="22"
                       MinHeight="48"
                       FlowDirection="LeftToRight"
                       KeyDown="OnTenderKeyDown" />
              <Button Grid.Column="2"
                      Content="المبلغ بالضبط"
                      Command="{Binding SetExactTenderCommand}" />
            </Grid>
            <TextBlock Text="{Binding TenderHint}" Foreground="#12382F" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
            <Button Content="تأكيد النقد"
                    Command="{Binding ConfirmCashCommand}"
                    IsEnabled="{Binding CanConfirmCash}"
                    MinWidth="140"
                    Background="#12382F"
                    Foreground="#F6F1E4" />
            <Button Content="إلغاء"
                    Command="{Binding CancelTenderCommand}"
                    MinWidth="140" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding AmountLabel}" Foreground="#6E675C" FontSize="13" />
            <TextBlock Text="{Binding AmountText}" FontSize="32" FontWeight="Bold" Foreground="#12382F" />
          </StackPanel>
          <Button Grid.Column="2"
                  Content="شاشة العميل"
                  Command="{Binding ShowCustomerDisplayCommand}"
                  Margin="0,0,8,0" />
          <Button Grid.Column="3"
                  Content="إتمام الدفع"
                  Command="{Binding BeginCashPaymentCommand}"
                  IsEnabled="{Binding CanBeginPayment}"
                  MinWidth="160"
                  Background="#12382F"
                  Foreground="#F6F1E4" />
        </Grid>

        <TextBlock Text="{Binding SettlementText}"
                   IsVisible="{Binding ShowSettlement}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#12382F" />

        <StackPanel Spacing="2">
          <TextBlock Text="{Binding ShellNotice}" FontSize="12" Foreground="#6E675C" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CatalogCaption}" FontSize="12" Foreground="#6E675C" />
          <TextBlock Text="{Binding DatabasePath}" FontSize="11" Foreground="#8A8172" FlowDirection="LeftToRight" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>

  <Border Background="#CC0F1C18" IsVisible="{Binding NeedsLogin}" ZIndex="20">
    <Border Background="#FFFcfaf4" BorderBrush="#DDD6C8" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="دخول الكاشير" FontSize="24" FontWeight="Bold" Foreground="#12382F" />
        <TextBlock Text="{Binding SessionCaption}" TextWrapping="Wrap" Foreground="#6E675C" />
        <TextBox Text="{Binding PinText}"
                 PlaceholderText="الرقم السري"
                 PasswordChar="•"
                 FontSize="28"
                 MinHeight="52"
                 FlowDirection="LeftToRight" />
        <TextBlock Text="{Binding AuthError}" Foreground="#B42318" TextWrapping="Wrap" />
        <Button Content="دخول"
                Command="{Binding SubmitPinCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="#12382F"
                Foreground="#F6F1E4"
                MinHeight="48" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F1C18" IsVisible="{Binding NeedsOpenShift}" ZIndex="21">
    <Border Background="#FFFcfaf4" BorderBrush="#DDD6C8" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="فتح وردية" FontSize="24" FontWeight="Bold" Foreground="#12382F" />
        <TextBlock Text="{Binding CashierName}" Foreground="#6E675C" />
        <TextBlock Text="نقدية الافتتاح (ج.م)" Foreground="#6E675C" />
        <TextBox Text="{Binding OpeningFloatText}"
                 FontSize="24"
                 MinHeight="52"
                 FlowDirection="LeftToRight" />
        <TextBlock Text="{Binding ShiftError}" Foreground="#B42318" TextWrapping="Wrap" />
        <Button Content="فتح الوردية"
                Command="{Binding OpenShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="#12382F"
                Foreground="#F6F1E4"
                MinHeight="48" />
        <Button Content="قفل الجهاز"
                Command="{Binding LockSessionCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F1C18" IsVisible="{Binding ShowCloseShift}" ZIndex="22">
    <Border Background="#FFFcfaf4" BorderBrush="#DDD6C8" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="إغلاق الوردية" FontSize="24" FontWeight="Bold" Foreground="#12382F" />
        <TextBlock Text="نقدية الإغلاق (ج.م)" Foreground="#6E675C" />
        <TextBox Text="{Binding ClosingCashText}"
                 FontSize="24"
                 MinHeight="52"
                 FlowDirection="LeftToRight" />
        <TextBlock Text="{Binding ShiftError}" Foreground="#B42318" TextWrapping="Wrap" />
        <Button Content="تأكيد الإغلاق"
                Command="{Binding ConfirmCloseShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Background="#12382F"
                Foreground="#F6F1E4"
                MinHeight="48" />
        <Button Content="إلغاء"
                Command="{Binding CancelCloseShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
