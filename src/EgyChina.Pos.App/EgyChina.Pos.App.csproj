<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\EgyChina.ico</ApplicationIcon>
    <ApplicationTitle>ايجي شاينا — نقطة البيع</ApplicationTitle>
    <Product>EgyChina POS</Product>
    <Company>EgyChina</Company>
    <Version>0.3.21</Version>
    <Description>Local-first cashier shell for Souq El Obour.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EgyChina.Pos.Core\EgyChina.Pos.Core.csproj" />
    <ProjectReference Include="..\EgyChina.Pos.Data\EgyChina.Pos.Data.csproj" />
    <ProjectReference Include="..\EgyChina.Pos.Sync\EgyChina.Pos.Sync.csproj" />
    <ProjectReference Include="..\EgyChina.Pos.Printing\EgyChina.Pos.Printing.csproj" />
  </ItemGroup>

  <!-- Ship brand + payment assets next to the exe; PosPaths copies them into LocalAppData on first use. -->
  <ItemGroup>
    <None Include="..\..\assets\logo-ar.png" Link="assets\logo-ar.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\logo-ar.png')" />
    <None Include="..\..\assets\wechat-qr.jpg" Link="assets\wechat-qr.jpg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\wechat-qr.jpg')" />
    <None Include="..\..\assets\instapay-qr.jpeg" Link="assets\instapay-qr.jpeg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\instapay-qr.jpeg')" />
  </ItemGroup>

</Project>
