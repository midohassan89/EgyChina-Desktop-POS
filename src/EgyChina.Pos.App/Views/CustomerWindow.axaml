<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EgyChina.Pos.App.ViewModels"
        x:Class="EgyChina.Pos.App.Views.CustomerWindow"
        x:DataType="vm:PosSession"
        Title="شاشة العميل — ايجي شاينا"
        FlowDirection="RightToLeft"
        WindowStartupLocation="Manual"
        Background="#064E3B"
        RequestedThemeVariant="Dark"
        MinWidth="480"
        MinHeight="560">

  <Window.Styles>
    <Style Selector="Border.cfd-line">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="18,14" />
    </Style>
    <Style Selector="Border.cfd-line.highlighted">
      <Setter Property="Background" Value="#ECFDF5" />
      <Setter Property="BorderBrush" Value="#10B981" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <Grid>
    <!-- IDLE — closer to web: brand + clock + welcome -->
    <Grid IsVisible="{Binding IsCfdIdle}">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#022C22" Offset="0" />
          <GradientStop Color="#065F46" Offset="0.55" />
          <GradientStop Color="#047857" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="40">
        <Border Width="88" Height="88" CornerRadius="22" Background="#ECFDF5"
                HorizontalAlignment="Center" BorderBrush="#A7F3D0" BorderThickness="2">
          <TextBlock Text="EC"
                     FontSize="34"
                     FontWeight="Bold"
                     Foreground="#047857"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FlowDirection="LeftToRight" />
        </Border>
        <TextBlock Text="ايجي شاينا ماركت"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="#F8FAFC"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <TextBlock Text="سوق العبور · EgyChina Hyper Market"
                   FontSize="18"
                   Foreground="#A7F3D0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <Border Background="#052E1F" CornerRadius="28" Padding="36,22" Margin="0,18,0,0"
                BorderBrush="#10B981" BorderThickness="1" HorizontalAlignment="Center" MinWidth="280">
          <TextBlock Text="{Binding ClockText}"
                     FontSize="56"
                     FontWeight="Bold"
                     Foreground="#F8FAFC"
                     HorizontalAlignment="Center"
                     FlowDirection="LeftToRight" />
        </Border>
        <TextBlock Text="{Binding IdleGreetingText}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#ECFDF5"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   MaxWidth="560" />
        <TextBlock Text="{Binding DisplayBanner}"
                   FontSize="13"
                   Foreground="#6EE7B7"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   IsVisible="{Binding HasDisplayBanner}"
                   Margin="0,12,0,0"
                   MaxWidth="520"
                   Opacity="0.85" />
      </StackPanel>
    </Grid>

    <!-- SHOPPING — white bill + dark totals rail (web CFD structure) -->
    <Grid IsVisible="{Binding IsCfdShopping}" ColumnDefinitions="0.34*,*">
      <Border Background="#0F172A" Padding="22,28">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,24">
            <TextBlock Text="ايجي شاينا" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock Text="EgyChina" FontSize="13" Foreground="#94A3B8" FlowDirection="LeftToRight" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <TextBlock Text="المبلغ المطلوب" FontSize="15" Foreground="#94A3B8" />
            <Border Background="#059669" CornerRadius="16" Padding="16,18">
              <TextBlock Text="{Binding TotalText}"
                         FontSize="36"
                         FontWeight="Bold"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
          <StackPanel Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="عدد الأصناف" FontSize="15" Foreground="#94A3B8" />
            <TextBlock Text="{Binding LineCountText}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#F8FAFC" Padding="28,24">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="فاتورتك الحالية" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="您的当前账单 · Your current bill" FontSize="14" Foreground="#64748B" FlowDirection="LeftToRight" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CartLine">
                  <Border Classes="cfd-line" Classes.highlighted="{Binding IsHighlighted}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding NameAr}" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NameZh}" FontSize="14" Foreground="#64748B" FlowDirection="LeftToRight"
                                   IsVisible="{Binding HasNameZh}" />
                        <TextBlock Text="{Binding QtyText, StringFormat=الكمية: {0}}" FontSize="14" Foreground="#059669" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding LineTotalText}"
                                 FontSize="24"
                                 FontWeight="Bold"
                                 Foreground="#0F172A"
                                 VerticalAlignment="Center"
                                 Margin="16,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- PAYMENT -->
    <Grid IsVisible="{Binding IsCfdPayment}">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#022C22" Offset="0" />
          <GradientStop Color="#064E3B" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Border Background="#0B1220"
                CornerRadius="24"
                Padding="36,28"
                MinWidth="360"
                MaxWidth="480"
                Margin="0,0,18,0"
                BorderBrush="#1E293B"
                BorderThickness="1">
          <StackPanel Spacing="12">
            <TextBlock Text="الدفع / Payment" FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PaymentMethodLabel}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#34D399"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PaymentMethodLabelZh}"
                       FontSize="15"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <TextBlock Text="المستحق" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="{Binding TotalText}"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding WeChatCnyText}"
                       IsVisible="{Binding IsWeChatPayment}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#86EFAC"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CustomerChangeText}"
                       IsVisible="{Binding ShowCustomerChange}"
                       FontSize="26"
                       Foreground="#FBBF24"
                       HorizontalAlignment="Center" />
            <TextBlock Text="جارٍ الدفع نقداً"
                       IsVisible="{Binding IsCashPayment}"
                       FontSize="17"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                IsVisible="{Binding ShowWeChatQr}"
                Background="White"
                CornerRadius="24"
                Padding="22"
                Width="340"
                VerticalAlignment="Center"
                BoxShadow="0 12 40 0 #40000000">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="امسح الكود للدفع"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       TextAlignment="Center" />
            <TextBlock Text="Scan to Pay · 请扫码付款"
                       FontSize="13"
                       Foreground="#047857"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#E2E8F0" BorderThickness="1">
              <Image x:Name="WeChatQrImage"
                     Width="250"
                     Height="250"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     IsVisible="False" />
            </Border>
            <TextBlock x:Name="WeChatQrFallback"
                       Text="ضع wechat-qr.jpg في مجلد assets"
                       FontSize="12"
                       Foreground="#64748B"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                IsVisible="{Binding ShowInstaPayQr}"
                Background="White"
                CornerRadius="24"
                Padding="22"
                Width="340"
                VerticalAlignment="Center"
                BoxShadow="0 12 40 0 #40000000">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="امسح الكود عبر إنستا باي"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#5B2B8C"
                       TextAlignment="Center" />
            <TextBlock Text="Scan to Pay · InstaPay"
                       FontSize="13"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#E2E8F0" BorderThickness="1">
              <Image x:Name="InstaPayQrImage"
                     Width="250"
                     Height="250"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     IsVisible="False" />
            </Border>
            <TextBlock x:Name="InstaPayQrFallback"
                       Text="ضع instapay-qr.jpeg في مجلد assets"
                       FontSize="12"
                       Foreground="#64748B"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
            <TextBlock Text="أو التحويل على الرقم:"
                       FontSize="13"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding InstaPayPhoneHint}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#5B2B8C"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- COMPLETED -->
    <Grid IsVisible="{Binding IsCfdCompleted}">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#022C22" Offset="0" />
          <GradientStop Color="#065F46" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="40">
        <Border Width="96" Height="96" CornerRadius="48" Background="#10B981"
                HorizontalAlignment="Center">
          <TextBlock Text="✓"
                     FontSize="48"
                     FontWeight="Bold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="شكراً لكم"
                   FontSize="44"
                   FontWeight="Bold"
                   Foreground="#F8FAFC"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Thank you · 谢谢"
                   FontSize="20"
                   Foreground="#A7F3D0"
                   HorizontalAlignment="Center"
                   FlowDirection="LeftToRight" />
        <Border Background="#052E1F" CornerRadius="18" Padding="28,20" MinWidth="360"
                BorderBrush="#10B981" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding SettlementText}"
                       FontSize="20"
                       Foreground="#F8FAFC"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="الباقي" FontSize="18" Foreground="#94A3B8" />
              <TextBlock Grid.Column="1"
                         Text="{Binding AmountText}"
                         FontSize="28"
                         FontWeight="Bold"
                         Foreground="#FBBF24" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
