<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EgyChina.Pos.App.ViewModels"
        x:Class="EgyChina.Pos.App.Views.CustomerWindow"
        x:DataType="vm:PosSession"
        Title="شاشة العميل — ايجي شاينا"
        FlowDirection="RightToLeft"
        WindowStartupLocation="Manual"
        Background="#052E1F"
        RequestedThemeVariant="Dark"
        MinWidth="480"
        MinHeight="560">

  <Window.Styles>
    <Style Selector="Border.cfd-line">
      <Setter Property="Background" Value="#0B1210" />
      <Setter Property="BorderBrush" Value="#1F2937" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.cfd-line.highlighted">
      <Setter Property="Background" Value="#064E3B" />
      <Setter Property="BorderBrush" Value="#10B981" />
    </Style>
  </Window.Styles>

  <Grid>
    <!-- IDLE -->
    <Grid IsVisible="{Binding IsCfdIdle}" Margin="40">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <TextBlock Text="ايجي شاينا ماركت"
                   FontSize="42"
                   FontWeight="Bold"
                   Foreground="#F6F1E4"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <TextBlock Text="سوق العبور"
                   FontSize="22"
                   Foreground="#E3C57A"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding IdleGreetingText}"
                   FontSize="30"
                   Foreground="#A7F3D0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
        <TextBlock Text="{Binding ClockText}"
                   FontSize="48"
                   FontWeight="SemiBold"
                   Foreground="#F6F1E4"
                   HorizontalAlignment="Center"
                   FlowDirection="LeftToRight"
                   Margin="0,20,0,0" />
        <TextBlock Text="{Binding DisplayBanner}"
                   FontSize="14"
                   Foreground="#8FA399"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   IsVisible="{Binding HasDisplayBanner}"
                   Margin="0,16,0,0"
                   MaxWidth="520" />
      </StackPanel>
    </Grid>

    <!-- SHOPPING -->
    <Grid IsVisible="{Binding IsCfdShopping}" ColumnDefinitions="*,0.42*" Margin="24,20">
      <DockPanel Margin="0,0,16,0">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,16">
          <TextBlock Text="ايجي شاينا ماركت" FontSize="28" FontWeight="Bold" Foreground="#F6F1E4" />
          <TextBlock Text="سلتك" FontSize="16" Foreground="#8FA399" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CartLine">
                <Border Classes="cfd-line" Classes.highlighted="{Binding IsHighlighted}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding NameAr}" FontSize="24" FontWeight="SemiBold" Foreground="#F6F1E4" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding LineTotalText}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#E3C57A"
                               Margin="16,0,0,0" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,6,0,0">
                      <TextBlock Text="{Binding NameZh}" FontSize="16" Foreground="#8FA399" FlowDirection="LeftToRight"
                                 IsVisible="{Binding HasNameZh}" />
                      <TextBlock Text="{Binding QtyText}" FontSize="16" Foreground="#A7F3D0" FlowDirection="LeftToRight" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="1" Background="#0B1210" CornerRadius="18" Padding="20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="8">
            <TextBlock Text="الإجمالي" FontSize="18" Foreground="#8FA399" />
            <Border Background="#059669" CornerRadius="14" Padding="16,14">
              <TextBlock Text="{Binding TotalText}"
                         FontSize="40"
                         FontWeight="Bold"
                         Foreground="White"
                         HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Spacing="10">
            <TextBlock Text="ملخص" FontSize="20" FontWeight="Bold" Foreground="#F6F1E4" />
            <TextBlock Text="{Binding LineCountText}" FontSize="16" Foreground="#8FA399" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- PAYMENT -->
    <Grid IsVisible="{Binding IsCfdPayment}" Margin="24">
      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="#0B1210"
                CornerRadius="24"
                Padding="36,28"
                MinWidth="380"
                MaxWidth="520"
                Margin="0,0,16,0">
          <StackPanel Spacing="14">
            <TextBlock Text="الدفع" FontSize="22" Foreground="#8FA399" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PaymentMethodLabel}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#34D399"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PaymentMethodLabelZh}"
                       FontSize="16"
                       Foreground="#8FA399"
                       HorizontalAlignment="Center" />
            <TextBlock Text="المستحق" FontSize="16" Foreground="#8FA399" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding TotalText}"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#F6F1E4"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding WeChatCnyText}"
                       IsVisible="{Binding IsWeChatPayment}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#86EFAC"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CustomerChangeText}"
                       IsVisible="{Binding ShowCustomerChange}"
                       FontSize="28"
                       Foreground="#E3C57A"
                       HorizontalAlignment="Center" />
            <TextBlock Text="جارٍ الدفع نقداً"
                       IsVisible="{Binding IsCashPayment}"
                       FontSize="18"
                       Foreground="#8FA399"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- WeChat QR panel -->
        <Border Grid.Column="1"
                IsVisible="{Binding ShowWeChatQr}"
                Background="White"
                CornerRadius="24"
                Padding="20"
                Width="320"
                VerticalAlignment="Center">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="امسح الكود للدفع / Scan to Pay"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="请扫码付款"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#047857"
                       HorizontalAlignment="Center" />
            <Image x:Name="WeChatQrImage"
                   Width="240"
                   Height="240"
                   Stretch="Uniform"
                   HorizontalAlignment="Center" />
            <TextBlock x:Name="WeChatQrFallback"
                       Text="ضع wechat-qr.jpg في مجلد assets"
                       FontSize="12"
                       Foreground="#64748B"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
          </StackPanel>
        </Border>

        <!-- InstaPay QR panel -->
        <Border Grid.Column="1"
                IsVisible="{Binding ShowInstaPayQr}"
                Background="White"
                CornerRadius="24"
                Padding="20"
                Width="320"
                VerticalAlignment="Center">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="امسح الكود للدفع عبر إنستا باي"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#5B2B8C"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="Scan to Pay · InstaPay"
                       FontSize="13"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <Image x:Name="InstaPayQrImage"
                   Width="240"
                   Height="240"
                   Stretch="Uniform"
                   HorizontalAlignment="Center" />
            <TextBlock x:Name="InstaPayQrFallback"
                       Text="ضع instapay-qr.jpeg في مجلد assets"
                       FontSize="12"
                       Foreground="#64748B"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
            <TextBlock Text="أو التحويل على الرقم:"
                       FontSize="14"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding InstaPayPhoneHint}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#5B2B8C"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- COMPLETED -->
    <Grid IsVisible="{Binding IsCfdCompleted}" Margin="40">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
        <Border Width="88" Height="88" CornerRadius="44" Background="#059669"
                HorizontalAlignment="Center">
          <TextBlock Text="✓"
                     FontSize="44"
                     FontWeight="Bold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="شكراً لكم"
                   FontSize="42"
                   FontWeight="Bold"
                   Foreground="#F6F1E4"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Thank you · 谢谢"
                   FontSize="20"
                   Foreground="#A7F3D0"
                   HorizontalAlignment="Center" />
        <Border Background="#0B1210" CornerRadius="18" Padding="28,20" MinWidth="360">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding SettlementText}"
                       FontSize="20"
                       Foreground="#F6F1E4"
                       HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="الباقي" FontSize="18" Foreground="#8FA399" />
              <TextBlock Grid.Column="1"
                         Text="{Binding AmountText}"
                         FontSize="28"
                         FontWeight="Bold"
                         Foreground="#E3C57A" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
