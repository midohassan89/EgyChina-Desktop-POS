<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EgyChina.Pos.App.Controls.TouchKeyboard"
             Focusable="False"
             FlowDirection="LeftToRight"
             ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="Button.osk-key">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#64748B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="2,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.osk-key:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#38BDF8" />
      <Setter Property="BorderBrush" Value="#E0F2FE" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="Button.osk-key:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0284C7" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.osk-key.accent">
      <Setter Property="Background" Value="#0F766E" />
      <Setter Property="BorderBrush" Value="#5EEAD4" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.osk-key.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FBBF24" />
      <Setter Property="BorderBrush" Value="#FEF3C7" />
      <Setter Property="Foreground" Value="#78350F" />
    </Style>
    <Style Selector="Button.osk-enter">
      <Setter Property="Background" Value="#059669" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="BorderBrush" Value="#6EE7B7" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.osk-enter:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#34D399" />
      <Setter Property="Foreground" Value="#064E3B" />
    </Style>
    <Style Selector="Button.osk-action">
      <Setter Property="Background" Value="#334155" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="BorderBrush" Value="#94A3B8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.osk-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F472B6" />
      <Setter Property="BorderBrush" Value="#FCE7F3" />
      <Setter Property="Foreground" Value="#831843" />
    </Style>
  </UserControl.Styles>

  <Border Background="#0B1220"
          BorderBrush="#475569"
          BorderThickness="1,1,1,0"
          CornerRadius="14,14,0,0"
          Padding="8,8,8,10"
          ClipToBounds="True"
          BoxShadow="0 -6 20 0 #88000000">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
        <TextBlock x:Name="TitleBlock"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center" />
        <Button x:Name="LanguageButton"
                Grid.Column="1"
                Classes="osk-action"
                MinWidth="64"
                Click="OnToggleLanguage"
                Margin="0,0,6,0" />
        <Button Grid.Column="2"
                Content="إخفاء"
                Classes="osk-action"
                MinWidth="80"
                Click="OnHide"
                Margin="0,0,6,0" />
        <Button Grid.Column="3"
                Content="Enter ↵"
                Classes="osk-enter"
                MinWidth="100"
                Click="OnEnter" />
      </Grid>
      <!-- Scroll when the till is short so bottom rows never vanish -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False">
        <StackPanel x:Name="RowsHost" Spacing="5" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
