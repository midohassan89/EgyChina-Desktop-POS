<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EgyChina.Pos.App.ViewModels"
        xmlns:core="using:EgyChina.Pos.Core"
        xmlns:data="using:EgyChina.Pos.Data"
        x:Class="EgyChina.Pos.App.Views.CashierWindow"
        x:DataType="vm:PosSession"
        x:Name="CashierRoot"
        Title="ايجي شاينا — نقطة البيع"
        FlowDirection="RightToLeft"
        WindowStartupLocation="Manual"
        Background="#EEF2F7"
        MinWidth="960"
        MinHeight="680">

  <Grid>
  <Grid RowDefinitions="Auto,*">
    <!-- Ops header: brand + cashier + status chips + actions -->
    <Border Grid.Row="0" Background="#0B1220" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="8" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Height="40" MinWidth="40" MaxWidth="168" CornerRadius="10" Background="#000000"
                    Padding="6,4" VerticalAlignment="Center" ClipToBounds="True"
                    BorderBrush="#D4AF37" BorderThickness="1">
              <Image Source="{DynamicResource BrandLogo}"
                     Stretch="Uniform"
                     Height="32"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="ايجي شاينا ماركت" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
              <TextBlock Text="{Binding CashierName}" FontSize="13" Foreground="#A7F3D0"
                         IsVisible="{Binding !NeedsLogin}" />
            </StackPanel>
            <Border Background="#831843" CornerRadius="999" Padding="12,4" VerticalAlignment="Center"
                    BorderBrush="#FB7185" BorderThickness="1">
              <TextBlock Text="{Binding SessionChipText}" FontSize="12" FontWeight="SemiBold" Foreground="#FFE4E6" />
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border CornerRadius="999" Padding="10,4" Background="#065F46" IsVisible="{Binding IsOnline}"
                    ToolTip.Tip="الجهاز يستطيع التواصل مع سيرفر ERP">
              <TextBlock Text="{Binding OnlineText}" FontSize="12" FontWeight="SemiBold" Foreground="#ECFDF5" />
            </Border>
            <Border CornerRadius="999" Padding="10,4" Background="#7F1D1D" IsVisible="{Binding !IsOnline}"
                    ToolTip.Tip="لا يوجد رابط ERP مضبوط أو السيرفر غير متاح. البيع المحلي يعمل عادي.">
              <TextBlock Text="{Binding OnlineText}" FontSize="12" FontWeight="SemiBold" Foreground="#FEE2E2" />
            </Border>
            <Button Command="{Binding OpenOutboxPanelCommand}"
                    Padding="10,4" CornerRadius="999" BorderThickness="1"
                    Background="#1E293B" BorderBrush="#334155"
                    IsVisible="{Binding IsOutboxHealthy}"
                    ToolTip.Tip="مبيعات محفوظة محلياً وبانتظار رفعها لـ ERP عند توفر الإعدادات">
              <TextBlock Text="{Binding OutboxStatusText}" FontSize="12" Foreground="#E2E8F0" />
            </Button>
            <Button Command="{Binding OpenOutboxPanelCommand}"
                    Padding="10,4" CornerRadius="999" BorderThickness="1"
                    Background="#78350F" BorderBrush="#F59E0B"
                    IsVisible="{Binding !IsOutboxHealthy}"
                    ToolTip.Tip="هناك مبيعات فشل رفعها — افتح القائمة لإعادة المحاولة">
              <TextBlock Text="{Binding OutboxStatusText}" FontSize="12" Foreground="#FEF3C7" />
            </Button>
            <Border CornerRadius="999" Padding="10,4" Background="#064E3B" IsVisible="{Binding IsPrinterReady}">
              <TextBlock Text="طابعة جاهزة" FontSize="12" Foreground="#D1FAE5" />
            </Border>
            <Border CornerRadius="999" Padding="10,4" Background="#44403C" IsVisible="{Binding !IsPrinterReady}">
              <TextBlock Text="طابعة غير مضبوطة" FontSize="12" Foreground="#E7E5E4" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding SyncMessage}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SyncErrorCaption}" IsVisible="{Binding HasSyncError}"
                     FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding ClockText}" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"
                     FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="{Binding ReturnModeButtonText}"
                  Classes="pos-chip-return"
                  Command="{Binding ToggleReturnModeCommand}"
                  IsEnabled="{Binding CanToggleReturnMode}" />
          <Button Content="{Binding OnlineOrdersButtonText}"
                  Classes="pos-chip-online"
                  Command="{Binding OpenOnlineOrdersCommand}"
                  IsEnabled="{Binding CanOpenOnlineOrders}" />
          <Button Content="تسجيل خروج"
                  Classes="pos-ghost"
                  Command="{Binding LockSessionCommand}"
                  IsEnabled="{Binding CanLock}"
                  ToolTip.Tip="تسجيل خروج الكاشير (F2) — الجلسة تُحفظ حتى تضغط هنا" />
          <Button Content="المزيد ▾"
                  Classes="pos-chip-info"
                  Command="{Binding ToggleMoreActionsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main stage: cart (RTL right) | catalog — matches web POS proportions -->
    <Grid Grid.Row="1" Margin="12" ColumnDefinitions="Auto,12,*">
      <!-- Cart column -->
      <Border Grid.Column="0"
              Width="400"
              Background="#FFFFFF"
              BorderBrush="#E2E8F0"
              BorderThickness="1"
              CornerRadius="18"
              Padding="14"
              BoxShadow="0 8 28 0 #14000000">
        <Border.Styles>
          <Style Selector="Border.cart-line">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
          </Style>
          <Style Selector="Border.cart-line.highlighted">
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
        </Border.Styles>
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Spacing="2">
              <TextBlock Text="الطلب الحالي" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
              <TextBlock Text="{Binding LineCountText}" FontSize="13" Foreground="#64748B" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="تعليق"
                    Command="{Binding HoldCurrentCartCommand}"
                    IsEnabled="{Binding CanHoldCart}"
                    Classes="pos-chip-warn"
                    VerticalAlignment="Center" />
          </Grid>

          <Border DockPanel.Dock="Top"
                  Background="#FEF3C7"
                  BorderBrush="#F59E0B"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  IsVisible="{Binding ShowReturnModeBanner}">
            <TextBlock Text="{Binding ReturnModeBanner}"
                       Foreground="#92400E"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       FontSize="13" />
          </Border>

          <Border DockPanel.Dock="Top"
                  Background="#EFF6FF"
                  BorderBrush="#3B82F6"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  IsVisible="{Binding HasActiveQueueTicket}">
            <TextBlock Text="{Binding ActiveQueueCaption}"
                       Foreground="#1D4ED8"
                       FontWeight="SemiBold"
                       FontSize="13" />
          </Border>

          <Border DockPanel.Dock="Top"
                  Background="#ECFDF5"
                  BorderBrush="#10B981"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,8"
                  Margin="0,0,0,8"
                  IsVisible="{Binding HasLoyaltyCustomer}">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding LoyaltyCaption}"
                           Foreground="#065F46"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           FontSize="13" />
                <TextBlock Text="{Binding LoyaltyDiscountText}"
                           IsVisible="{Binding ShowLoyaltyDiscount}"
                           Foreground="#B45309"
                           FontWeight="SemiBold"
                           FontSize="12" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{Binding RedeemLoyaltyButtonText}"
                      Command="{Binding ToggleRedeemLoyaltyCommand}"
                      IsEnabled="{Binding CanToggleRedeemLoyalty}"
                      Background="#D1FAE5"
                      Foreground="#065F46"
                      MinWidth="110" />
              <Button Grid.Column="3"
                      Content="إزالة"
                      Command="{Binding ClearLoyaltyCommand}"
                      Background="#FEE2E2"
                      Foreground="#B91C1C"
                      MinWidth="72" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Spacing="8">
              <Border Background="#ECFDF5" CornerRadius="14" Padding="14,12"
                      BorderBrush="#A7F3D0" BorderThickness="1"
                      IsVisible="{Binding !IsTendering}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding AmountLabel}" Foreground="#047857" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="32" FontWeight="Bold" Foreground="#047857" />
                  </Grid>
                  <TextBlock Text="{Binding LoyaltyDiscountText}"
                             IsVisible="{Binding ShowLoyaltyDiscount}"
                             Foreground="#B45309"
                             FontWeight="SemiBold"
                             FontSize="13" />
                </StackPanel>
              </Border>

              <Border Background="#0B1220" CornerRadius="16" Padding="14,12"
                      IsVisible="{Binding IsTendering}">
                <StackPanel Spacing="10">
                  <TextBlock Text="اختر طريقة الدفع" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" />
                  <UniformGrid Columns="3" Rows="2">
                    <Button Margin="4" Tag="Cash" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-cash"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <StackPanel Spacing="2">
                        <TextBlock Text="كاش" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="Cash" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="4" Tag="Visa" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-visa"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <StackPanel Spacing="2">
                        <TextBlock Text="فيزا" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="Visa" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="4" Tag="Wallet" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-wallet"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <StackPanel Spacing="2">
                        <TextBlock Text="محفظة" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="Wallet" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="4" Tag="InstaPay" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-instapay"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <StackPanel Spacing="2">
                        <TextBlock Text="انستا باي" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="InstaPay" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                    <Button Margin="4" Tag="WeChat" Click="OnPaymentMethodClick" Classes="pos-tender pos-pay-wechat"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <StackPanel Spacing="2">
                        <TextBlock Text="وي شات" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="WeChat" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" Foreground="White" FlowDirection="LeftToRight" />
                      </StackPanel>
                    </Button>
                  </UniformGrid>
                  <Border Background="#111827" CornerRadius="12" Padding="12,10" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding PaymentMethodLabel}" FontSize="18" FontWeight="Bold" Foreground="#6EE7B7" />
                      <TextBlock Text="{Binding PaymentMethodLabelEn}" FontSize="13" Foreground="#CBD5E1" FlowDirection="LeftToRight" />
                      <TextBlock Text="{Binding PaymentMethodLabelZh}" FontSize="13" Foreground="#94A3B8" />
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="6" IsVisible="{Binding IsWeChatPayment}">
                    <TextBlock Text="سعر الصرف (ج.م / يوان)" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ExchangeRateText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             FlowDirection="LeftToRight"
                             MinHeight="44" />
                    <TextBlock Text="{Binding WeChatCnyText}" FontSize="20" FontWeight="Bold" Foreground="#86EFAC" />
                  </StackPanel>

                  <TextBlock Text="المبلغ المستلم" Foreground="#94A3B8" FontSize="13" IsVisible="{Binding IsCashPayment}" />
                  <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding IsCashPayment}">
                    <TextBox x:Name="TenderBox"
                             Grid.Column="0"
                             Text="{Binding TenderText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="0.00"
                             FontSize="22"
                             MinHeight="48"
                             FlowDirection="LeftToRight"
                             KeyDown="OnTenderKeyDown" />
                    <Button Grid.Column="2"
                            Content="بالضبط"
                            Classes="pos-tender"
                            Background="#64748B"
                            Command="{Binding SetExactTenderCommand}" />
                  </Grid>
                  <TextBlock Text="{Binding TenderHint}" Foreground="#E2E8F0" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,8,*">
                    <Button Grid.Column="0"
                            Content="تأكيد الدفع"
                            Classes="pos-primary"
                            Command="{Binding ConfirmCashCommand}"
                            IsEnabled="{Binding CanConfirmCash}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="56"
                            FontSize="18" />
                    <Button Grid.Column="2"
                            Content="إلغاء"
                            Classes="pos-tender"
                            Command="{Binding CancelTenderCommand}"
                            Background="#64748B"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            MinHeight="56" />
                  </Grid>
                </StackPanel>
              </Border>

              <Button Content="الدفع"
                      Classes="pos-primary"
                      Command="{Binding BeginCashPaymentCommand}"
                      IsEnabled="{Binding CanBeginPayment}"
                      IsVisible="{Binding !IsTendering}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="62"
                      FontSize="24"
                      FontWeight="Bold"
                      CornerRadius="14" />

              <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding !IsTendering}">
                <Button Content="{Binding HeldCartsButtonText}"
                        Command="{Binding OpenHeldCartsCommand}"
                        IsEnabled="{Binding CanOpenHeldCarts}"
                        Background="#FEF3C7"
                        Foreground="#92400E"
                        CornerRadius="12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Content="تفريغ"
                        Command="{Binding ClearCartCommand}"
                        Background="#FEE2E2"
                        Foreground="#B91C1C"
                        CornerRadius="12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
              </Grid>

              <TextBlock Text="{Binding SettlementText}"
                         IsVisible="{Binding ShowSettlement}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="#047857"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <StackPanel DockPanel.Dock="Top"
                      IsVisible="{Binding IsCartEmpty}"
                      Margin="8,48,8,0"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="السلة فارغة"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="#94A3B8" />
            <TextBlock Text="امسح باركود أو اختر صنفاً للبدء"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="#CBD5E1"
                       TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CartLine">
                  <Border Classes="cart-line" Classes.highlighted="{Binding IsHighlighted}">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                      <Border Grid.RowSpan="2" Width="52" Height="52" CornerRadius="12" Background="#F1F5F9"
                              ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Grid>
                          <Border Background="#0B1220"
                                  IsVisible="{Binding ProductId, Converter={StaticResource MissingProductImage}}">
                            <Image Source="{DynamicResource BrandLogo}" Stretch="Uniform" Margin="8" Opacity="0.9" />
                          </Border>
                          <Image Source="{Binding ProductId, Converter={StaticResource ProductImage}}"
                                 Stretch="UniformToFill"
                                 IsVisible="{Binding ProductId, Converter={StaticResource HasProductImage}}" />
                        </Grid>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayNameAr}" FontWeight="SemiBold" TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis" MaxLines="2" MaxHeight="44" Foreground="#0F172A" />
                      <TextBlock Grid.Column="2" Text="{Binding LineTotalText}" FontWeight="Bold" Foreground="#059669" />
                      <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight">
                          <Button Content="−" Command="{Binding DecrementCommand}" Classes="pos-qty" />
                          <Border MinWidth="44" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                  CornerRadius="10" Padding="10,8">
                            <TextBlock Text="{Binding QtyText}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="#0F172A"
                                       FlowDirection="LeftToRight" />
                          </Border>
                          <Button Content="+" Command="{Binding IncrementCommand}" Classes="pos-qty" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="حذف"
                                Command="{Binding RemoveCommand}"
                                Classes="pos-qty-del" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Catalog column -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top"
                Background="#FDECEC"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8"
                Margin="0,0,0,8"
                IsVisible="{Binding HasCashierAlert}">
          <TextBlock Text="{Binding CashierAlert}" Foreground="#B91C1C" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <Border DockPanel.Dock="Top"
                Background="White"
                CornerRadius="16"
                Padding="10"
                Margin="0,0,0,10"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                BoxShadow="0 4 16 0 #0F000000">
          <Grid ColumnDefinitions="*,10,Auto">
            <TextBox x:Name="BarcodeBox"
                     Grid.Column="0"
                     Text="{Binding Barcode}"
                     PlaceholderText="ابحث بالاسم أو امسح الباركود..."
                     FontSize="18"
                     MinHeight="48"
                     BorderThickness="0"
                     Background="Transparent"
                     KeyDown="OnBarcodeKeyDown" />
            <Button Grid.Column="2"
                    Content="إدخال"
                    Classes="pos-primary"
                    MinWidth="96"
                    CornerRadius="12"
                    Click="OnBarcodeSubmit" />
          </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ScanHint}" Margin="0,0,0,8" Foreground="#64748B" TextWrapping="Wrap" FontSize="13" />

        <TextBox x:Name="SearchBox"
                 DockPanel.Dock="Top"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="تصفية سريعة بالاسم أو الباركود"
                 MinHeight="44"
                 Margin="0,0,0,10" />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button DockPanel.Dock="Left"
                  Content="فحص سعر F4"
                  Command="{Binding OpenPriceCheckCommand}"
                  Classes="pos-chip-info"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center" />
          <Border Background="#F8FAFC" CornerRadius="14" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1">
            <ScrollViewer Classes="pos-cats">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="الكل"
                        Command="{Binding ShowAllCatalogCommand}"
                        Classes="pos-tender"
                        Background="#059669"
                        CornerRadius="999"
                        Padding="16,8"
                        MinHeight="40"
                        Opacity="{Binding CatalogAllEmphasis}"
                        HorizontalContentAlignment="Center" />
                <Button Content="★ المفضلة"
                        Command="{Binding ShowFavoritesCatalogCommand}"
                        Background="#FEF3C7"
                        Foreground="#92400E"
                        CornerRadius="999"
                        Padding="16,8"
                        MinHeight="40"
                        Opacity="{Binding CatalogFavoritesEmphasis}"
                        HorizontalContentAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CatalogCategory">
                      <Button Content="{Binding ChipText}"
                              Tag="{Binding}"
                              Click="OnCategoryClick"
                              Background="#E0F2FE"
                              Foreground="#0C4A6E"
                              CornerRadius="999"
                              Padding="14,8"
                              MinHeight="40"
                              MaxWidth="220"
                              HorizontalContentAlignment="Center">
                        <Button.Styles>
                          <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#BAE6FD" />
                            <Setter Property="Foreground" Value="#0C4A6E" />
                          </Style>
                        </Button.Styles>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding SelectedCategoryCaption}"
                   IsVisible="{Binding HasSelectedCategory}"
                   Margin="0,0,0,8"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#0369A1" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2">
          <TextBlock Text="{Binding ShortcutHint}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PrinterCaption}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CatalogCaption}" FontSize="12" Foreground="#64748B" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="لا توجد أصناف مطابقة"
                   IsVisible="{Binding HasNoSearchResults}"
                   Margin="0,8,0,0"
                   Foreground="#64748B" />
        <TextBlock DockPanel.Dock="Top"
                   Text="لا مفضلات بعد — اضغط ★ على البطاقة"
                   IsVisible="{Binding HasNoFavorites}"
                   Margin="0,4,0,8"
                   Foreground="#64748B" />

        <Border Background="#FFFFFF" CornerRadius="18" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1"
                BoxShadow="0 6 20 0 #10000000">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <!-- Virtualized grid: all 3000+ products without loading every bitmap at once -->
            <ItemsRepeater ItemsSource="{Binding VisibleProducts}">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="188"
                                   MinItemHeight="210"
                                   MinColumnSpacing="12"
                                   MinRowSpacing="12"
                                   ItemsStretch="Fill"
                                   ItemsJustification="Start" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="core:CatalogProduct">
                  <Border MinHeight="200"
                          Padding="0"
                          Background="#FFFFFF"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          CornerRadius="16"
                          Cursor="Hand"
                          BoxShadow="0 4 14 0 #12000000"
                          Tapped="OnProductTapped">
                    <DockPanel>
                      <Border DockPanel.Dock="Top"
                              Height="110"
                              CornerRadius="16,16,0,0"
                              Background="#F1F5F9"
                              ClipToBounds="True">
                        <Grid>
                          <Border Background="#0B1220"
                                  IsVisible="{Binding Converter={StaticResource MissingProductImage}}">
                            <Image Source="{DynamicResource BrandLogo}"
                                   Stretch="Uniform"
                                   Margin="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.95" />
                          </Border>
                          <Image Source="{Binding Converter={StaticResource ProductImage}}"
                                 Stretch="UniformToFill"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 IsVisible="{Binding Converter={StaticResource HasProductImage}}" />
                          <Button Content="{Binding FavoriteGlyph}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="8"
                                  MinHeight="32"
                                  MinWidth="36"
                                  Padding="4,0"
                                  Background="#FEF9C3"
                                  Foreground="#A16207"
                                  CornerRadius="999"
                                  FontSize="14"
                                  Click="OnFavoriteClick"
                                  Tag="{Binding}" />
                        </Grid>
                      </Border>
                      <StackPanel Spacing="4" Margin="12,10,12,12">
                        <TextBlock Text="{Binding DisplayNameAr}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" MaxHeight="44" Foreground="#0F172A" />
                        <TextBlock Text="{Binding NameZh}" FontSize="11" Foreground="#94A3B8" FlowDirection="LeftToRight"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   IsVisible="{Binding HasNameZh}" />
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" Margin="0,6,0,0">
                          <TextBlock Text="{Binding PriceEgpText}" FontSize="16" FontWeight="Bold" Foreground="#047857" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </Grid>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowHeldCarts}" ZIndex="38">
    <Border Background="White" BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F59E0B" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="السلال المعلّقة" FontSize="24" FontWeight="Bold" Foreground="#1C1917" />
              <TextBlock Text="استرجاع يعلّق السلة الحالية تلقائياً إن لم تكن فارغة" FontSize="13" Foreground="#44403C" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="إغلاق"
                    Command="{Binding CloseHeldCartsCommand}"
                    Background="#D97706"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top"
                   Margin="20,12,20,0"
                   Text="{Binding HeldCartError}"
                   IsVisible="{Binding HasHeldCartError}"
                   Foreground="#B91C1C"
                   TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top"
                   Margin="20,24"
                   Text="لا توجد سلال معلّقة"
                   IsVisible="{Binding !HasHeldCarts}"
                   HorizontalAlignment="Center"
                   Foreground="#78716C" />
        <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding HeldCarts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:HeldCartSummary">
                <Border Margin="0,0,0,10"
                        Padding="14"
                        Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="12">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Caption}" FontSize="16" FontWeight="SemiBold" Foreground="#1C1917" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{Binding HeldAt}" FontSize="12" Foreground="#78716C" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Content="استرجاع"
                              Tag="{Binding}"
                              Click="OnResumeHeldClick"
                              Background="#059669"
                              Foreground="White"
                              MinWidth="88" />
                      <Button Content="حذف"
                              Tag="{Binding}"
                              Click="OnDiscardHeldClick"
                              Background="#FEE2E2"
                              Foreground="#B91C1C"
                              MinWidth="72" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowSupervisorPin}" ZIndex="45">
    <Border Background="#F8FAFC" BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#B45309" Padding="20,16">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding SupervisorTitle}" FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
            <TextBlock Text="رقم سري للمشرف أو المدير فقط" FontSize="13" Foreground="#FDE68A" />
          </StackPanel>
        </Border>
        <StackPanel Margin="24" Spacing="12">
          <TextBlock Text="{Binding SupervisorHint}" Foreground="#64748B" TextWrapping="Wrap" />
          <TextBox x:Name="SupervisorPinBox"
                   Text="{Binding SupervisorPinText}"
                   PlaceholderText="الرقم السري"
                   PasswordChar="•"
                   FontSize="28"
                   MinHeight="52"
                   FlowDirection="LeftToRight"
                   KeyDown="OnSupervisorPinKeyDown" />
          <TextBlock Text="{Binding SupervisorError}"
                     IsVisible="{Binding HasSupervisorError}"
                     Foreground="#B91C1C"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,8,*">
            <Button Grid.Column="0"
                    Content="تأكيد"
                    Classes="pos-primary"
                    Command="{Binding SubmitSupervisorPinCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="48" />
            <Button Grid.Column="2"
                    Content="إلغاء"
                    Command="{Binding CancelSupervisorPinCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    MinHeight="48" />
          </Grid>
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#E0111111" IsVisible="{Binding ShowNotFound}" ZIndex="40">
    <Border Background="#FFF7F7" BorderBrush="#B91C1C" BorderThickness="5" CornerRadius="18"
            Padding="0" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="0 20 50 0 #66000000">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#B91C1C" Padding="22,18">
          <StackPanel Spacing="4">
            <TextBlock Text="المنتج غير متوفر" FontSize="26" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="Product not found — أكّد قبل المتابعة" FontSize="14" Foreground="#FECACA" />
          </StackPanel>
        </Border>
        <StackPanel Margin="24" Spacing="14">
          <Border Background="#FEE2E2" CornerRadius="12" Padding="14,10">
            <TextBlock Text="{Binding NotFoundBarcode, StringFormat=الباركود: {0}}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#7F1D1D"
                       FlowDirection="LeftToRight"
                       TextWrapping="Wrap" />
          </Border>
          <TextBlock Text="يجب تأكيد الخطأ قبل مسح الصنف التالي." Foreground="#334155" FontSize="15" TextWrapping="Wrap" />
          <Button x:Name="NotFoundOkButton"
                  Content="OK · موافق"
                  Command="{Binding DismissNotFoundCommand}"
                  Background="#B91C1C"
                  Foreground="White"
                  FontSize="22"
                  FontWeight="Bold"
                  MinHeight="60"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  CornerRadius="12" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowPriceCheck}" ZIndex="39">
    <Border Background="White" BorderBrush="#0284C7" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0284C7" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="فحص السعر" FontSize="24" FontWeight="Bold" Foreground="White" />
              <TextBlock Text="استعلام فقط — لا يُضاف للسلة" FontSize="13" Foreground="#E0F2FE" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="إغلاق"
                    Command="{Binding ClosePriceCheckCommand}"
                    Background="#0369A1"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
        </Border>
        <StackPanel Margin="24" Spacing="12">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox x:Name="PriceCheckBox"
                     Grid.Column="0"
                     Text="{Binding PriceCheckQuery}"
                     PlaceholderText="امسح أو اكتب الباركود"
                     FontSize="20"
                     MinHeight="50"
                     FlowDirection="LeftToRight"
                     KeyDown="OnPriceCheckKeyDown" />
            <Button Grid.Column="2"
                    Content="بحث"
                    Command="{Binding SubmitPriceCheckCommand}"
                    Background="#0284C7"
                    Foreground="White"
                    MinWidth="88" />
          </Grid>
          <Border IsVisible="{Binding HasPriceCheckResult}"
                  Background="#F0F9FF"
                  BorderBrush="#BAE6FD"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding PriceCheckResult.NameAr}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PriceCheckResult.NameZh}" FontSize="14" Foreground="#64748B"
                         IsVisible="{Binding PriceCheckResult.HasNameZh}" FlowDirection="LeftToRight" />
              <TextBlock Text="{Binding PriceCheckResult.PriceEgpText}" FontSize="28" FontWeight="Bold" Foreground="#0284C7" />
              <TextBlock Text="{Binding PriceCheckResult.Barcode}" FontSize="13" Foreground="#64748B" FlowDirection="LeftToRight" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding PriceCheckError}"
                     IsVisible="{Binding HasPriceCheckError}"
                     Foreground="#B91C1C"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding NeedsDeviceLink}" ZIndex="25">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="ربط الجهاز بسيرفر ERP" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="أدخل PIN المدير أو الأدمن مرة واحدة لربط هذا الجهاز ورفع المبيعات ومزامنة موظفي الكاشير."
                   TextWrapping="Wrap" Foreground="#64748B" />
        <TextBox Text="{Binding DeviceLinkPin}"
                 PlaceholderText="PIN المدير"
                 PasswordChar="•"
                 FontSize="28"
                 MinHeight="52"
                 FlowDirection="LeftToRight" />
        <TextBlock Text="{Binding DeviceLinkError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="ربط الجهاز"
                Classes="pos-primary"
                Command="{Binding SubmitDeviceLinkCommand}"
                IsEnabled="{Binding !IsDeviceLinkBusy}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding NeedsLogin}" ZIndex="20">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="دخول الكاشير" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="{Binding SessionCaption}" TextWrapping="Wrap" Foreground="#64748B" />
        <TextBox x:Name="PinBox"
                 Text="{Binding PinText}"
                 PlaceholderText="PIN الموظف"
                 PasswordChar="•"
                 FontSize="28"
                 MinHeight="52"
                 FlowDirection="LeftToRight"
                 KeyDown="OnPinKeyDown" />
        <TextBlock Text="{Binding AuthError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="دخول"
                Classes="pos-primary"
                Command="{Binding SubmitPinCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding NeedsOpenShift}" ZIndex="21">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="12">
        <TextBlock Text="فتح وردية" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="{Binding CashierName}" Foreground="#64748B" />
        <TextBlock Text="نقدية الافتتاح (ج.م)" Foreground="#64748B" />
        <TextBox x:Name="OpeningFloatBox"
                 Text="{Binding OpeningFloatText}"
                 FontSize="24"
                 MinHeight="52"
                 FlowDirection="LeftToRight"
                 KeyDown="OnOpeningFloatKeyDown" />
        <TextBlock Text="{Binding ShiftError}" Foreground="#B91C1C" TextWrapping="Wrap" />
        <Button Content="فتح الوردية"
                Classes="pos-primary"
                Command="{Binding OpenShiftCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                MinHeight="48" />
        <Button Content="تسجيل خروج"
                Command="{Binding LockSessionCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowCloseShift}" ZIndex="22">
    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14"
            Padding="24" Width="480" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <TextBlock Text="إغلاق الوردية · تقرير Z" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
          <Border IsVisible="{Binding HasZReport}"
                  Background="#F1F5F9"
                  CornerRadius="10"
                  Padding="12"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding CurrentZReport.CashierName}" FontWeight="SemiBold" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.TicketCountText, StringFormat=عدد التذاكر: {0}}" Foreground="#475569" />
              <TextBlock Text="{Binding CurrentZReport.ReturnTicketCountText, StringFormat=استرجاع: {0}}" Foreground="#475569" />
              <TextBlock Text="{Binding CurrentZReport.CashSalesText, StringFormat=نقد: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.VisaSalesText, StringFormat=فيزا: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.WalletSalesText, StringFormat=محفظة: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.InstaPaySalesText, StringFormat=انستا باي: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.WeChatSalesText, StringFormat=وي شات: {0}}" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentZReport.CashRefundsText, StringFormat=مردود نقدي: {0}}" Foreground="#B45309" />
              <TextBlock Text="{Binding CurrentZReport.TotalSalesText, StringFormat=إجمالي المبيعات: {0}}" FontWeight="Bold" Foreground="#047857" />
              <TextBlock Text="{Binding CurrentZReport.ExpectedCashText, StringFormat=النقد المتوقع في الدرج: {0}}" FontWeight="Bold" Foreground="#1D4ED8" />
            </StackPanel>
          </Border>
          <TextBlock Text="نقدية الإغلاق الفعلية (ج.م)" Foreground="#64748B" />
          <TextBox x:Name="ClosingCashBox"
                   Text="{Binding ClosingCashText, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="24"
                   MinHeight="52"
                   FlowDirection="LeftToRight"
                   KeyDown="OnClosingCashKeyDown" />
          <TextBlock Text="{Binding ZReportVarianceText}"
                     IsVisible="{Binding HasZReport}"
                     FontWeight="SemiBold"
                     Foreground="#0F172A"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ShiftError}" Foreground="#B91C1C" TextWrapping="Wrap" />
          <Button Content="تأكيد الإغلاق"
                  Classes="pos-primary"
                  Command="{Binding ConfirmCloseShiftCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  MinHeight="48" />
          <Button Content="إلغاء"
                  Command="{Binding CancelCloseShiftCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowOnlineOrders}" ZIndex="38">
    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0"
            Width="420" HorizontalAlignment="Left" VerticalAlignment="Stretch">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="16,12">
          <Grid ColumnDefinitions="*,Auto,8,Auto">
            <TextBlock Text="طلبات الأونلاين" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="تحديث"
                    Command="{Binding RefreshOnlineOrdersCommand}"
                    Background="#1E293B"
                    Foreground="White"
                    MinWidth="72" />
            <Button Grid.Column="3"
                    Content="إغلاق"
                    Command="{Binding CloseOnlineOrdersCommand}"
                    Background="#334155"
                    Foreground="White"
                    MinWidth="72" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding OnlineOrdersError}"
                   IsVisible="{Binding HasOnlineOrdersError}"
                   Background="#FEF2F2"
                   Foreground="#B91C1C"
                   Padding="12,8"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top"
                   Text="لا توجد طلبات أونلاين"
                   IsVisible="{Binding HasNoOnlineOrders}"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"
                   Foreground="#94A3B8" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding OnlineOrders}" Margin="12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:OnlineOrderSummary">
                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,10">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding OrderNumber}" FontWeight="Bold" FontSize="16" Foreground="#0F172A" />
                      <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="Bold" Foreground="#059669" />
                    </Grid>
                    <TextBlock Text="{Binding StatusLabelAr}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" />
                    <TextBlock Text="{Binding CustomerName}" Foreground="#334155" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Phone}" Foreground="#64748B" FlowDirection="LeftToRight" />
                    <TextBlock Text="{Binding Address}"
                               IsVisible="{Binding HasAddress}"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               FontSize="12" />
                    <TextBlock Text="{Binding ItemsSummary}" Foreground="#475569" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding AssignedDriverName, StringFormat=السائق: {0}}"
                               IsVisible="{Binding HasAssignedDriver}"
                               Foreground="#78716C"
                               FontSize="12" />
                    <TextBlock Text="{Binding Notes}"
                               IsVisible="{Binding HasNotes}"
                               Foreground="#A16207"
                               TextWrapping="Wrap"
                               FontSize="12" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>

  <Border Background="#990B1220" IsVisible="{Binding ShowMoreActions}" ZIndex="45"
          PointerPressed="OnMoreActionsBackdrop">
    <Border Background="#111827" BorderBrush="#475569" BorderThickness="1" CornerRadius="16"
            Padding="16" Width="320" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,72,16,0" BoxShadow="0 16 40 0 #60000000">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="المزيد" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
          <Button Grid.Column="1" Content="إغلاق" Command="{Binding CloseMoreActionsCommand}"
                  Classes="pos-tender" Background="#64748B" MinWidth="72" MinHeight="40" />
        </Grid>
        <Button Content="فتح الدرج"
                Classes="pos-chip-drawer"
                Command="{Binding OpenCashDrawerCommand}"
                IsEnabled="{Binding CanOpenDrawer}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="شاشة العميل"
                Classes="pos-chip-info"
                Command="{Binding ShowCustomerDisplayCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="إعادة طباعة"
                Classes="pos-tender"
                Background="#475569"
                Command="{Binding ReprintLastCommand}"
                IsEnabled="{Binding CanReprint}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="مبيعات بانتظار الرفع"
                Classes="pos-tender"
                Background="#0EA5E9"
                Command="{Binding OpenOutboxPanelCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
        <Button Content="تقفيل الكاشير"
                Classes="pos-chip-danger"
                Command="{Binding BeginCloseShiftCommand}"
                IsEnabled="{Binding CanOpenCloseShiftPanel}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>
  </Border>

  <Border Background="#CC0F172A" IsVisible="{Binding ShowOutboxPanel}" ZIndex="46">
    <Border Background="White" BorderBrush="#F59E0B" BorderThickness="3" CornerRadius="16"
            Padding="0" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F59E0B" Padding="20,16">
          <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="مبيعات بانتظار الرفع" FontSize="22" FontWeight="Bold" Foreground="#1C1917" />
              <TextBlock Text="مبيعات تمت على الجهاز ولم تُرفع بعد لسيرفر ERP" FontSize="13" Foreground="#44403C" />
            </StackPanel>
            <Button Grid.Column="1" Content="تحديث" Command="{Binding RefreshOutboxPanelCommand}"
                    Background="#D97706" Foreground="White" MinWidth="80" />
            <Button Grid.Column="3" Content="إعادة محاولة" Command="{Binding RetryOutboxSyncCommand}"
                    Background="#059669" Foreground="White" MinWidth="110" />
            <Button Grid.Column="5" Content="إغلاق" Command="{Binding CloseOutboxPanelCommand}"
                    Background="#92400E" Foreground="White" MinWidth="80" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding OutboxPanelHint}"
                   IsVisible="{Binding HasOutboxPanelHint}"
                   Margin="16,12,16,0" Foreground="#047857" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding SyncErrorCaption}"
                   IsVisible="{Binding HasSyncError}"
                   Margin="16,8,16,0" Foreground="#B91C1C" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Text="لا عناصر معلّقة أو تالفة"
                   IsVisible="{Binding HasNoOutboxRows}"
                   HorizontalAlignment="Center" Margin="0,40,0,0" Foreground="#94A3B8" />
        <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding OutboxRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="data:OutboxHealthRow">
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                        CornerRadius="12" Padding="12" Margin="0,0,0,10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#92400E" />
                    <TextBlock Text="{Binding AttemptCount, StringFormat=محاولات: {0}}" FontSize="12" Foreground="#64748B" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Border>
  </Grid>
</Window>
