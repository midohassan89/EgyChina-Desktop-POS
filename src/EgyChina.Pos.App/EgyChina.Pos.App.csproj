<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>ايجي شاينا — نقطة البيع</ApplicationTitle>
    <Product>EgyChina POS</Product>
    <Company>EgyChina</Company>
    <Version>0.1.0</Version>
    <Description>Local-first cashier shell for Souq El Obour.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EgyChina.Pos.Core\EgyChina.Pos.Core.csproj" />
    <ProjectReference Include="..\EgyChina.Pos.Data\EgyChina.Pos.Data.csproj" />
    <ProjectReference Include="..\EgyChina.Pos.Sync\EgyChina.Pos.Sync.csproj" />
    <ProjectReference Include="..\EgyChina.Pos.Printing\EgyChina.Pos.Printing.csproj" />
  </ItemGroup>

</Project>
