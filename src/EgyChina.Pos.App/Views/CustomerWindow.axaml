<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EgyChina.Pos.App.ViewModels"
        x:Class="EgyChina.Pos.App.Views.CustomerWindow"
        x:DataType="vm:PosSession"
        Title="شاشة العميل — ايجي شاينا"
        FlowDirection="RightToLeft"
        WindowStartupLocation="Manual"
        Background="#0B1220"
        RequestedThemeVariant="Dark"
        MinWidth="480"
        MinHeight="560">

  <Window.Styles>
    <Style Selector="Border.cfd-line">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.cfd-line.highlighted">
      <Setter Property="Background" Value="#ECFDF5" />
      <Setter Property="BorderBrush" Value="#059669" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #33059669" />
    </Style>
  </Window.Styles>

  <Grid>
    <!-- IDLE -->
    <Grid IsVisible="{Binding IsCfdIdle}">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#022C22" Offset="0" />
          <GradientStop Color="#064E3B" Offset="0.45" />
          <GradientStop Color="#0B1220" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="40">
        <Border Width="320" Height="132" CornerRadius="24" Background="#000000"
                HorizontalAlignment="Center" BorderBrush="#D4AF37" BorderThickness="2"
                Padding="18,14" ClipToBounds="True">
          <Image Source="{DynamicResource BrandLogo}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="سوق العبور · EgyChina Hyper Market"
                   FontSize="18"
                   Foreground="#A7F3D0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <Border Background="#052E1F" CornerRadius="28" Padding="40,24" Margin="0,10,0,0"
                BorderBrush="#10B981" BorderThickness="1" HorizontalAlignment="Center" MinWidth="300"
                BoxShadow="0 16 40 0 #40000000">
          <TextBlock Text="{Binding ClockText}"
                     FontSize="64"
                     FontWeight="Bold"
                     Foreground="#F8FAFC"
                     HorizontalAlignment="Center"
                     FlowDirection="LeftToRight" />
        </Border>
        <TextBlock Text="{Binding IdleGreetingText}"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="#ECFDF5"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   MaxWidth="600" />
        <TextBlock Text="{Binding DisplayBanner}"
                   FontSize="13"
                   Foreground="#6EE7B7"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   IsVisible="{Binding HasDisplayBanner}"
                   Margin="0,8,0,0"
                   MaxWidth="520"
                   Opacity="0.85" />
      </StackPanel>
    </Grid>

    <!-- SHOPPING -->
    <Grid IsVisible="{Binding IsCfdShopping}" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#0B1220" Padding="28,20" BorderBrush="#059669" BorderThickness="0,0,0,3">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="فاتورتك الحالية" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock Text="您的当前账单 · Your current bill" FontSize="14" Foreground="#94A3B8" FlowDirection="LeftToRight" />
            <TextBlock Text="{Binding LineCountText}" FontSize="15" Foreground="#6EE7B7" Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Background="#059669" CornerRadius="18" Padding="22,14" MinWidth="220"
                  VerticalAlignment="Center" BoxShadow="0 8 28 0 #40059669">
            <StackPanel Spacing="2">
              <TextBlock Text="المبلغ المطلوب" FontSize="13" Foreground="#D1FAE5" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding TotalText}"
                         FontSize="34"
                         FontWeight="Bold"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#F8FAFC" Padding="28,22">
        <ScrollViewer x:Name="CfdCartScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CartLine">
                <Border Classes="cfd-line" Classes.highlighted="{Binding IsHighlighted}" MinHeight="96">
                  <Grid ColumnDefinitions="72,16,*,16,Auto,16,140" MinHeight="72">
                    <Border Width="72" Height="72" CornerRadius="14" Background="#F1F5F9"
                            ClipToBounds="True" VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">
                      <Grid>
                        <Border Background="#0B1220"
                                IsVisible="{Binding ProductId, Converter={StaticResource MissingProductImage}}">
                          <Image Source="{DynamicResource BrandLogo}"
                                 Stretch="Uniform"
                                 Margin="10"
                                 Opacity="0.9" />
                        </Border>
                        <Image Source="{Binding ProductId, Converter={StaticResource ProductImage}}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding ProductId, Converter={StaticResource HasProductImage}}" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="0">
                      <TextBlock Text="{Binding DisplayNameAr}"
                                 FontSize="22"
                                 FontWeight="SemiBold"
                                 Foreground="#0F172A"
                                 TextWrapping="Wrap"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="2"
                                 MaxHeight="60" />
                      <TextBlock Text="{Binding NameZh}"
                                 FontSize="14"
                                 Foreground="#64748B"
                                 FlowDirection="LeftToRight"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1"
                                 IsVisible="{Binding ShowCustomerNameZh}" />
                    </StackPanel>
                    <Border Grid.Column="4"
                            Background="#ECFDF5"
                            CornerRadius="10"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            MinWidth="72">
                      <TextBlock Text="{Binding QtyCaption}"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Foreground="#047857"
                                 HorizontalAlignment="Center"
                                 FlowDirection="LeftToRight" />
                    </Border>
                    <TextBlock Grid.Column="6"
                               Text="{Binding LineTotalText}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Stretch"
                               TextAlignment="Left"
                               TextWrapping="NoWrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- PAYMENT -->
    <Grid IsVisible="{Binding IsCfdPayment}">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#022C22" Offset="0" />
          <GradientStop Color="#0B1220" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Border Background="#111827"
                CornerRadius="28"
                Padding="40,32"
                MinWidth="380"
                MaxWidth="520"
                Margin="0,0,20,0"
                BorderBrush="#1E293B"
                BorderThickness="1"
                BoxShadow="0 16 48 0 #60000000">
          <StackPanel Spacing="12">
            <TextBlock Text="الدفع / Payment / 付款" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PaymentMethodLabel}"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#34D399"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding PaymentMethodLabelEn}"
                       FontSize="16"
                       Foreground="#CBD5E1"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
            <TextBlock Text="{Binding PaymentMethodLabelZh}"
                       FontSize="15"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <TextBlock Text="المستحق" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock Text="{Binding TotalText}"
                       FontSize="52"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding WeChatCnyText}"
                       IsVisible="{Binding IsWeChatPayment}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#86EFAC"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CustomerChangeText}"
                       IsVisible="{Binding ShowCustomerChange}"
                       FontSize="26"
                       Foreground="#FBBF24"
                       HorizontalAlignment="Center" />
            <TextBlock Text="جارٍ الدفع نقداً"
                       IsVisible="{Binding IsCashPayment}"
                       FontSize="17"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                IsVisible="{Binding ShowWeChatQr}"
                Background="White"
                CornerRadius="28"
                Padding="26"
                Width="360"
                VerticalAlignment="Center"
                BoxShadow="0 16 48 0 #50000000">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="امسح للدفع"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       TextAlignment="Center" />
            <TextBlock Text="Scan to Pay · 请扫码付款"
                       FontSize="14"
                       Foreground="#047857"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
            <Border Background="#F8FAFC" CornerRadius="16" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
              <Image x:Name="WeChatQrImage"
                     Width="300"
                     Height="300"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     IsVisible="False" />
            </Border>
            <TextBlock x:Name="WeChatQrFallback"
                       Text="ضع wechat-qr.jpg في مجلد assets"
                       FontSize="12"
                       Foreground="#64748B"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                IsVisible="{Binding ShowInstaPayQr}"
                Background="White"
                CornerRadius="28"
                Padding="26"
                Width="360"
                VerticalAlignment="Center"
                BoxShadow="0 16 48 0 #50000000">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="امسح للدفع"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#5B2B8C"
                       TextAlignment="Center" />
            <TextBlock Text="Scan to Pay · InstaPay"
                       FontSize="14"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
            <Border Background="#F8FAFC" CornerRadius="16" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
              <Image x:Name="InstaPayQrImage"
                     Width="300"
                     Height="300"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     IsVisible="False" />
            </Border>
            <TextBlock x:Name="InstaPayQrFallback"
                       Text="ضع instapay-qr.jpeg في مجلد assets"
                       FontSize="12"
                       Foreground="#64748B"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
            <TextBlock Text="أو التحويل على الرقم:"
                       FontSize="13"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding InstaPayPhoneHint}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#5B2B8C"
                       HorizontalAlignment="Center"
                       FlowDirection="LeftToRight" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- COMPLETED -->
    <Grid IsVisible="{Binding IsCfdCompleted}">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#022C22" Offset="0" />
          <GradientStop Color="#065F46" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="40">
        <Border Width="104" Height="104" CornerRadius="52" Background="#10B981"
                HorizontalAlignment="Center" BoxShadow="0 12 36 0 #4010B981">
          <TextBlock Text="✓"
                     FontSize="52"
                     FontWeight="Bold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="شكراً لزيارتكم"
                   FontSize="46"
                   FontWeight="Bold"
                   Foreground="#F8FAFC"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Thank you · 谢谢光临"
                   FontSize="20"
                   Foreground="#A7F3D0"
                   HorizontalAlignment="Center"
                   FlowDirection="LeftToRight" />
        <Border Background="#052E1F" CornerRadius="20" Padding="32,22" MinWidth="380"
                BorderBrush="#10B981" BorderThickness="1"
                IsVisible="{Binding HasLastPointsEarned}">
          <StackPanel Spacing="4">
            <TextBlock Text="نقاط الولاء المكتسبة"
                       FontSize="15"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding LastPointsEarnedText}"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#FBBF24"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Background="#052E1F" CornerRadius="20" Padding="32,22" MinWidth="380"
                BorderBrush="#10B981" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding SettlementText}"
                       FontSize="20"
                       Foreground="#F8FAFC"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="الباقي" FontSize="18" Foreground="#94A3B8" />
              <TextBlock Grid.Column="1"
                         Text="{Binding AmountText}"
                         FontSize="28"
                         FontWeight="Bold"
                         Foreground="#FBBF24" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
